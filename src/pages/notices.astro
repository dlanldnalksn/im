---
import PublicLayout from '../layouts/PublicLayout.astro';
import { publicNotices } from '../data/notices';
---

<PublicLayout title="공지사항">
  <section class="px-6 lg:px-12 py-12">
    <div class="gemini-section-title">
      <span>알림마당</span>
    </div>
    <ul class="list-none m-0 p-0">
      {
        publicNotices.map((n) => (
          <li class="py-4 border-b border-[#eee]">
            <div class="flex flex-col sm:flex-row sm:justify-between gap-2">
              <span class="text-[15px] font-medium">{n.title}</span>
              <span class="font-mono text-[13px] text-[#999]">{n.date.replace(/-/g, '.')}</span>
            </div>
            <p class="text-sm text-[#666] mt-2 mb-0">{n.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>
</PublicLayout>
