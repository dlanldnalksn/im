---
import PublicLayout from '../layouts/PublicLayout.astro';
import { publicOrgs } from '../data/organizations-public';
---

<PublicLayout title="조직 소개">
  <section class="imc-page">
    <div class="imc-section-title">
      <span>조직 소개</span>
    </div>
    <div class="grid md:grid-cols-2 gap-4 mb-8">
      {
        publicOrgs.map((org) => (
          <article class="imc-agency-wide">
            <div class:list={['imc-agency-wide__icon', org.iconBg, org.iconColor]}>{org.hanja}</div>
            <div class="flex-1">
              <div class="flex items-center gap-2.5 mb-2">
                <span class="font-mono text-[10px] text-[#888] tracking-widest">{org.num}</span>
                <span class="text-[11px] text-imc-muted">{org.codeEn}</span>
              </div>
              <h2 class="text-lg font-extrabold mb-1">
                {org.name}
                <span class="text-xs text-[#888] font-serif ml-1">{org.nameHan}</span>
              </h2>
              <p class="text-[12.5px] text-imc-muted leading-relaxed m-0">{org.desc}</p>
              <p class="text-[11px] text-imc-muted mt-3 m-0">{org.location}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="text-sm text-imc-muted border-l-4 border-imc-border pl-4 max-w-2xl">
      일부 기밀·대응 업무는 대외 누리집에 공개되지 않을 수 있습니다.
    </p>
  </section>
</PublicLayout>
