---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/PageHero.astro';
import { publicOrgs } from '../data/organizations-public';
---

<PublicLayout title="조직 소개" fullWidth={true}>
  <PageHero
    label="SUBORDINATE AGENCIES"
    title="산하 기관 소개"
    description="이능관리위원회는 국무총리 직속으로 각성자 관련 업무를 총괄합니다."
  />
  <div class="px-4 md:px-10 py-10">
    <div class="grid md:grid-cols-3 gap-5 mb-8">
      {
        publicOrgs.map((org) => (
          <article class="agency-card">
            <div class="flex items-center justify-between mb-3.5">
              <div class:list={['w-10 h-10 flex items-center justify-center font-serif text-xl font-bold', org.iconBg, org.iconColor]}>
                {org.hanja}
              </div>
              <span class="font-mono text-[10px] text-[#999] tracking-widest">{org.num}</span>
            </div>
            <h2 class="text-lg font-bold tracking-tight mb-1">{org.name}</h2>
            <p class="text-[10.5px] text-imc-muted font-serif mb-3">{org.nameHan}</p>
            <p class="text-sm text-[#555] leading-relaxed">{org.desc}</p>
          </article>
        ))
      }
    </div>
    <p class="text-sm text-imc-muted border-l-4 border-imc-border pl-4 max-w-2xl">
      국가안보·질서 유지 관련 업무를 담당하는 기관은 법령 및 보안 규정에 따라
      대외 누리집에 공개되지 않습니다.
    </p>
  </div>
</PublicLayout>
