---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/PageHero.astro';
import { faqItems } from '../data/faq';
---

<PublicLayout title="FAQ" fullWidth={true}>
  <PageHero label="FAQ" title="자주 묻는 질문" description="등재·제도·허가 등 시민 FAQ입니다." />
  <div class="px-4 md:px-10 py-10 max-w-3xl space-y-3">
    {
      faqItems.map((item) => (
        <details class="bg-white border border-imc-border group">
          <summary class="font-semibold cursor-pointer list-none flex justify-between items-center px-5 py-4 text-sm tracking-tight hover:bg-[#fafbfc]">
            {item.q}
            <span class="text-imc-muted group-open:rotate-180 transition-transform text-xs">▼</span>
          </summary>
          <p class="px-5 pb-4 text-sm text-imc-muted leading-relaxed border-t border-[#f0f1f3] pt-3">{item.a}</p>
        </details>
      ))
    }
  </div>
</PublicLayout>
