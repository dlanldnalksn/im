---
import PublicLayout from '../layouts/PublicLayout.astro';
import { faqItems } from '../data/faq';
---

<PublicLayout title="FAQ">
  <section class="imc-page max-w-3xl">
    <div class="imc-section-title">
      <span>자주 묻는 질문</span>
    </div>
    <div class="space-y-3">
      {
        faqItems.map((item) => (
          <details class="border border-[#d0d0d0] bg-[#fafaf7] group">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center px-5 py-4 text-sm">
              {item.q}
              <span class="text-[#666] group-open:rotate-180 transition-transform text-xs">▼</span>
            </summary>
            <p class="px-5 pb-4 text-sm text-[#666] leading-relaxed border-t border-[#eee] pt-3 m-0">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</PublicLayout>
