---
import PublicLayout from '../layouts/PublicLayout.astro';
import { publicOrgs } from '../data/organizations-public';
import { url } from '../lib/url';

const notices = [
  { tag: 'important', label: '중요', title: '신천 사건 15주기 추모일 안내 및 등재자 활동 제한 조치 시행', date: '2026.05.21' },
  { tag: 'notice', label: '공지', title: '「국가 각성자 관리 체계 요약 백서」 제 17.3 호 발간', date: '2026.05.14' },
  { tag: 'notice', label: '공지', title: '등재자 정기 검진 일정 및 처방 안내 (2분기)', date: '2026.05.02' },
  { tag: 'admin', label: '행정', title: '등재자 신분증 갱신 절차 개정 안내 (시행일 6월 1일)', date: '2026.04.28' },
  { tag: 'admin', label: '행정', title: '차출요원 4분기 배치 계획 공고', date: '2026.04.20' },
  { tag: 'admin', label: '행정', title: '2026년도 동기화 매칭 우선순위 산정 기준 개정 안내', date: '2026.04.11' },
];

const quickLinks = [
  { icon: '📋', label: '등재 신청', href: 'registration/', bg: 'bg-[#e8eef5]' },
  { icon: '🆔', label: '신분증 갱신', href: 'registration/', bg: 'bg-[#e8eef5]' },
  { icon: '📍', label: '거주 이전 신고', href: 'registration/', bg: 'bg-[#e8eef5]' },
  { icon: '💊', label: '처방 안내', href: 'faq/', bg: 'bg-[#e8f0eb]' },
  { icon: '🔗', label: '동기화 등록', href: 'registration/', bg: 'bg-[#e8f0eb]' },
  { icon: '⚠', label: '미등재자 신고', href: 'faq/', bg: 'bg-[#f5e5e5]' },
];
---

<PublicLayout title="홈">
  <section class="imc-hero">
    <div class="imc-hero__glow-a"></div>
    <div class="imc-hero__glow-b"></div>
    <div class="relative z-[2] max-w-[780px]">
      <p class="imc-hero__eyebrow">POWER MANAGEMENT COMMITTEE · KOREA</p>
      <h2 class="imc-hero__title">
        국민과 함께,<br />
        안전한 사회를 위한<br />
        <span class="imc-hero__accent">이능 관리 체계</span>
      </h2>
      <p class="imc-hero__desc">
        이능관리위원회는 국무총리 직속 기관으로, 등재자의 안전한 사회 통합과 국민 보호를
        위해 산하 4개 기관과 함께 정책을 수립·시행합니다.
      </p>
      <div class="imc-hero__actions">
        <a href={url('about/')} class="imc-btn-white">위원회 소개 <span class="text-xs">→</span></a>
        <a href={url('registration/')} class="imc-btn-ghost">민원 신청 <span class="text-xs">→</span></a>
      </div>
    </div>
    <div class="imc-hero__watermark" aria-hidden="true">異能</div>
  </section>

  <a href={url('notices/')} class="imc-notice-strip">
    <span class="imc-notice-strip__badge">공지</span>
    <span class="imc-notice-strip__text">
      신천 사건 15주기 추모일 (D-3) — 당일 전후 등재자 사회활동 제한 강화 조치 안내
      <span class="text-[#888] ml-1.5">2026.05.21</span>
    </span>
    <span class="text-[#888] text-xs shrink-0">자세히 보기 →</span>
  </a>

  <section class="px-6 lg:px-10 pt-[60px] pb-10">
    <div class="imc-section-head">
      <div>
        <p class="imc-section-head__eyebrow">SUBORDINATE AGENCIES</p>
        <h2 class="imc-section-head__title">산하 기관 안내</h2>
      </div>
      <a href={url('organizations/')} class="imc-section-head__more">전체 보기 →</a>
    </div>
    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
      {
        publicOrgs.map((org) => (
          <a href={url(org.href)} class="imc-agency-card">
            <div class="flex items-center justify-between mb-3.5">
              <div class:list={['imc-agency-icon', org.iconBg, org.iconColor]}>{org.hanja}</div>
              <span class="font-mono text-[10px] text-[#999] tracking-widest">{org.num}</span>
            </div>
            <h3 class="text-[14.5px] font-bold mb-1 tracking-tight">{org.name}</h3>
            <p class="text-[10.5px] text-[#888] font-serif mb-2.5">{org.nameHan}</p>
            <p class="text-[11.5px] text-[#555] leading-relaxed m-0">{org.desc}</p>
            <p class="mt-3.5 text-[11px] text-imc-primary font-semibold m-0">바로가기 →</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="px-6 lg:px-10 pb-[60px] grid lg:grid-cols-[2fr_1fr] gap-6">
    <div class="imc-notice-panel">
      <div class="imc-notice-tabs">
        <a href={url('notices/')} class="imc-notice-tab is-active">공지사항</a>
        <span class="imc-notice-tab">새소식</span>
        <span class="imc-notice-tab">보도자료</span>
        <a href={url('notices/')} class="ml-auto text-xs text-imc-muted py-[18px] no-underline hover:underline">+ 더보기</a>
      </div>
      {
        notices.map((n) => (
          <a href={url('notices/')} class="imc-notice-row">
            <div class="flex gap-3 items-center flex-1 min-w-0">
              <span class:list={['imc-tag', n.tag === 'important' && 'imc-tag--important', n.tag === 'notice' && 'imc-tag--notice', n.tag === 'admin' && 'imc-tag--admin']}>
                {n.label}
              </span>
              <span class="text-[13px] truncate">{n.title}</span>
            </div>
            <span class="font-mono text-[11.5px] text-[#888] shrink-0">{n.date}</span>
          </a>
        ))
      }
    </div>

    <div class="flex flex-col gap-4">
      <a href={url('registration/')} class="imc-side-card imc-side-card--primary">
        <div class="absolute -top-8 -right-8 font-serif text-[90px] text-white/[0.06] font-bold leading-none pointer-events-none">民</div>
        <p class="imc-side-card__eyebrow text-[#a8c5d8] relative">CIVIL APPLICATION</p>
        <h3 class="text-[17px] font-bold mb-1.5 relative">민원 신청</h3>
        <p class="text-[11.5px] text-[#cfd8e0] leading-relaxed mb-3.5 relative m-0">등재·갱신·이의신청·각종 허가</p>
        <span class="text-[11.5px] font-semibold relative">신청 바로가기 →</span>
      </a>
      <a href={url('faq/')} class="imc-side-card">
        <p class="imc-side-card__eyebrow text-imc-danger">REPORT</p>
        <h3 class="text-[15.5px] font-bold mb-1.5">미등재자 신고</h3>
        <p class="text-[11.5px] text-imc-muted leading-relaxed mb-3 m-0">익명 신고 가능 · 포상금 지급</p>
        <span class="text-[11.5px] text-imc-danger font-bold">신고하기 →</span>
      </a>
      <div class="imc-side-card">
        <p class="imc-side-card__eyebrow text-imc-primary">INQUIRY</p>
        <h3 class="text-[15.5px] font-bold mb-1.5">상담 문의</h3>
        <p class="text-[11.5px] text-imc-muted leading-relaxed mb-3 m-0">평일 09:00 ~ 18:00</p>
        <p class="text-sm font-bold font-mono tracking-wide m-0">☎ 1551-0000</p>
      </div>
    </div>
  </section>

  <section class="imc-stat-section">
    <div class="imc-section-head">
      <div>
        <p class="imc-section-head__eyebrow">STATISTICS</p>
        <h2 class="imc-section-head__title">주요 통계 (2025년 기준)</h2>
      </div>
      <a href={url('resources/')} class="imc-section-head__more">통계 자료실 →</a>
    </div>
    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
      <div class="imc-stat-card">
        <p class="text-[11.5px] text-imc-muted mb-2">등재자 총원</p>
        <p class="imc-stat-value m-0">1,184,720<span class="text-sm text-[#888] font-semibold ml-1">명</span></p>
        <p class="text-[11px] text-[#2d5f3f] mt-1.5 m-0">▲ 전년 대비 +2.3%</p>
      </div>
      <div class="imc-stat-card">
        <p class="text-[11.5px] text-imc-muted mb-2">능력자 비율</p>
        <p class="imc-stat-value m-0">2.1<span class="text-lg text-[#888] font-bold">%</span></p>
        <p class="text-[11px] text-[#888] mt-1.5 m-0">전체 인구 대비</p>
      </div>
      <div class="imc-stat-card">
        <p class="text-[11.5px] text-imc-muted mb-2">조력자 비율</p>
        <p class="imc-stat-value m-0">0.34<span class="text-lg text-[#888] font-bold">%</span></p>
        <p class="text-[11px] text-[#888] mt-1.5 m-0">능력자 대비 약 1/6</p>
      </div>
      <div class="imc-stat-card">
        <p class="text-[11.5px] text-imc-muted mb-2">매칭 완료 건수</p>
        <p class="imc-stat-value m-0">3,847<span class="text-sm text-[#888] font-semibold ml-1">건</span></p>
        <p class="text-[11px] text-[#2d5f3f] mt-1.5 m-0">▲ 전년 대비 +148건</p>
      </div>
    </div>
  </section>

  <section class="px-6 lg:px-10 py-12">
    <div class="mb-6">
      <p class="imc-section-head__eyebrow">QUICK LINKS</p>
      <h2 class="imc-section-head__title">자주 찾는 서비스</h2>
    </div>
    <div class="imc-quick-grid">
      {
        quickLinks.map((item) => (
          <a href={url(item.href)} class="imc-quick-item">
            <div class:list={['imc-quick-icon', item.bg]}>{item.icon}</div>
            <span class="text-xs font-semibold">{item.label}</span>
          </a>
        ))
      }
    </div>
  </section>
</PublicLayout>
