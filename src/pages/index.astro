---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/PageHero.astro';
import { publicNotices } from '../data/notices';
import { publicOrgs } from '../data/organizations-public';
import { url } from '../lib/url';

const featuredNotice = publicNotices.find((n) => n.id === 'n2') ?? publicNotices[0];
const noticeItems = [
  { badge: '중요', badgeClass: 'bg-imc-danger', ...publicNotices[1] },
  { badge: '공지', badgeClass: 'bg-imc-primary', ...publicNotices[0] },
  { badge: '공지', badgeClass: 'bg-imc-primary', ...publicNotices[2] },
];

const stats = [
  { label: '등재자 총원', value: '1,184,720', unit: '명', sub: '▲ 전년 대비 +2.3%', subClass: 'text-[#2d5f3f]' },
  { label: '능력자 비율', value: '2.1', unit: '%', sub: '전체 인구 대비', subClass: 'text-imc-muted' },
  { label: '조력자 비율', value: '0.34', unit: '%', sub: '능력자 대비 약 1/6', subClass: 'text-imc-muted' },
  { label: '매칭 완료 건수', value: '3,847', unit: '건', sub: '▲ 전년 대비 +148건', subClass: 'text-[#2d5f3f]' },
];

const quickLinks = [
  { emoji: '📋', label: '등재 신청', href: 'registration/' },
  { emoji: '🪪', label: '신분증 갱신', href: 'registration/' },
  { emoji: '🏥', label: '정기 검진', href: 'registration/' },
  { emoji: '📄', label: '백서 열람', href: 'resources/' },
  { emoji: '❓', label: 'FAQ', href: 'faq/' },
  { emoji: '📢', label: '공지사항', href: 'notices/' },
];
---

<PublicLayout title="홈" fullWidth={true}>
  <PageHero
    label="POWER MANAGEMENT COMMITTEE · KOREA"
    title={`국민과 함께,\n안전한 사회를 위한\n이능 관리 체계`}
    description="이능관리위원회는 국무총리 직속 기관으로, 등재자의 안전한 사회 통합과 국민 보호를 위해 산하 기관과 함께 정책을 수립·시행합니다."
  >
    <div class="flex flex-wrap gap-2.5 mt-8">
      <a href={url('about/')} class="btn-imc-primary">위원회 소개 <span>→</span></a>
      <a href={url('registration/')} class="btn-imc-outline">민원 신청 <span>→</span></a>
    </div>
  </PageHero>

  <!-- 긴급 공지 배너 -->
  <a
    href={url('notices/')}
    class="flex items-center gap-3 md:gap-4 bg-imc-notice border-b border-imc-notice-border px-4 md:px-10 py-3.5 hover:bg-[#fff3d4] transition-colors"
  >
    <span class="bg-[#b8860b] text-white text-[10.5px] font-bold px-2.5 py-0.5 tracking-widest shrink-0">공지</span>
    <span class="text-[13px] tracking-tight flex-1 truncate">{featuredNotice.title}</span>
    <span class="text-imc-muted text-xs shrink-0 hidden sm:inline">{featuredNotice.date.replace(/-/g, '.')}</span>
    <span class="text-imc-muted text-xs shrink-0">자세히 →</span>
  </a>

  <!-- 산하 기관 -->
  <section class="px-4 md:px-10 pt-12 md:pt-14 pb-10">
    <div class="flex justify-between items-end mb-7">
      <div>
        <p class="section-label">SUBORDINATE AGENCIES</p>
        <h2 class="section-title">산하 기관 안내</h2>
      </div>
      <a href={url('organizations/')} class="text-xs text-imc-muted hover:text-imc-primary transition-colors">전체 보기 →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        publicOrgs.map((org) => (
          <a href={url(org.href)} class="agency-card group">
            <div class="flex items-center justify-between mb-3.5">
              <div class:list={['w-10 h-10 flex items-center justify-center font-serif text-xl font-bold', org.iconBg, org.iconColor]}>
                {org.hanja}
              </div>
              <span class="font-mono text-[10px] text-[#999] tracking-widest">{org.num}</span>
            </div>
            <h3 class="text-[14.5px] font-bold tracking-tight mb-1">{org.name}</h3>
            <p class="text-[10.5px] text-imc-muted font-serif tracking-wide mb-2.5">{org.nameHan}</p>
            <p class="text-[11.5px] text-[#555] leading-relaxed">{org.desc}</p>
            <p class="mt-3.5 text-[11px] text-imc-primary font-semibold group-hover:underline">바로가기 →</p>
          </a>
        ))
      }
    </div>
    <p class="mt-4 text-xs text-imc-muted border-l-2 border-imc-border pl-3">
      국가안보·질서 유지 관련 업무 기관은 대외 공개 범위에 포함되지 않습니다.
    </p>
  </section>

  <!-- 공지 + 사이드 -->
  <section class="px-4 md:px-10 pb-10 grid lg:grid-cols-[2fr_1fr] gap-6">
    <div class="bg-white border border-imc-border">
      <div class="border-b border-imc-border flex items-center px-6">
        <span class="py-4 text-sm font-bold text-imc-primary border-b-2 border-imc-primary -mb-px">공지사항</span>
        <a href={url('notices/')} class="ml-auto text-xs text-imc-muted hover:text-imc-primary py-4">+ 더보기</a>
      </div>
      <ul>
        {
          noticeItems.map((n) => (
            <li class="px-6 py-3.5 flex justify-between items-center gap-4 border-b border-[#f0f1f3] last:border-0">
              <div class="flex items-center gap-3 min-w-0">
                <span class:list={['text-[10px] font-bold text-white px-1.5 py-0.5 tracking-widest shrink-0', n.badgeClass]}>
                  {n.badge}
                </span>
                <span class="text-[13px] tracking-tight truncate">{n.title}</span>
              </div>
              <span class="font-mono text-[11.5px] text-imc-muted shrink-0">{n.date.replace(/-/g, '.')}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <a href={url('registration/')} class="relative overflow-hidden bg-imc-primary text-white p-5 hover:bg-imc-primary-light transition-colors">
        <span class="absolute top-[-20px] right-[-20px] font-serif text-[90px] text-white/[0.06] font-bold leading-none">民</span>
        <p class="font-mono text-[10px] text-[#a8c5d8] tracking-widest mb-1.5 relative">CIVIL APPLICATION</p>
        <p class="text-[17px] font-bold tracking-tight mb-1.5 relative">민원 신청</p>
        <p class="text-[11.5px] text-[#cfd8e0] leading-relaxed mb-3 relative">등재 · 갱신 · 이의신청 · 각종 허가</p>
        <span class="text-[11.5px] font-semibold relative flex items-center gap-1">신청 바로가기 →</span>
      </a>
      <div class="bg-white border border-imc-border p-5">
        <p class="font-mono text-[10px] text-imc-danger tracking-widest font-bold mb-1.5">REPORT</p>
        <p class="text-[15.5px] font-bold tracking-tight mb-1.5">미등재자 신고</p>
        <p class="text-[11.5px] text-imc-muted leading-relaxed mb-3">익명 신고 가능 · 포상금 지급</p>
        <span class="text-[11.5px] text-imc-danger font-bold">신고하기 →</span>
      </div>
      <div class="bg-white border border-imc-border p-5">
        <p class="font-mono text-[10px] text-imc-primary tracking-widest font-bold mb-1.5">INQUIRY</p>
        <p class="text-[15.5px] font-bold tracking-tight mb-1.5">상담 문의</p>
        <p class="text-[11.5px] text-imc-muted mb-3">평일 09:00 ~ 18:00</p>
        <p class="text-sm font-bold font-mono tracking-wide">☎ 1551-0000</p>
      </div>
    </div>
  </section>

  <!-- 통계 -->
  <section class="bg-[#f8f9fb] px-4 md:px-10 py-12 border-t border-imc-border">
    <div class="flex justify-between items-end mb-7">
      <div>
        <p class="section-label">STATISTICS</p>
        <h2 class="section-title">주요 통계 (2025년 기준)</h2>
      </div>
      <a href={url('resources/')} class="text-xs text-imc-muted hover:text-imc-primary">통계 자료실 →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        stats.map((s) => (
          <div class="bg-white border border-imc-border p-6">
            <p class="text-[11.5px] text-imc-muted mb-2">{s.label}</p>
            <p class="text-3xl font-extrabold tracking-tight">
              {s.value}
              <span class="text-sm text-[#888] font-semibold ml-1">{s.unit}</span>
            </p>
            <p class:list={['text-[11px] mt-1.5', s.subClass]}>{s.sub}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 퀵 링크 -->
  <section class="px-4 md:px-10 py-12">
    <p class="section-label">QUICK LINKS</p>
    <h2 class="section-title mb-6">자주 찾는 서비스</h2>
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
      {
        quickLinks.map((q) => (
          <a href={url(q.href)} class="bg-white border border-imc-border py-5 px-3 text-center hover:border-imc-primary/40 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">{q.emoji}</div>
            <p class="text-xs font-semibold tracking-tight">{q.label}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 백서 배너 -->
  <section class="px-4 md:px-10 pb-12">
    <div class="relative bg-imc-cream border border-[#d0d0d0] p-6 md:p-8 pl-8">
      <div class="absolute top-0 left-0 w-1 h-full bg-imc-ink"></div>
      <p class="font-mono text-xs text-imc-muted tracking-widest mb-2">REPORT 202X-01 · 제 17.3 호</p>
      <h3 class="text-xl font-extrabold mb-2">국가 각성자 관리 체계 요약</h3>
      <p class="text-sm text-imc-muted mb-5 max-w-2xl">시민·신규 등재 희망자를 위한 공개 요약본입니다. 상세 운영 정보는 소관 부처에 문의하시기 바랍니다.</p>
      <a href={url('resources/')} class="inline-block bg-imc-ink text-white px-6 py-2.5 text-sm font-bold hover:bg-[#333] transition-colors">
        자료실에서 보기
      </a>
    </div>
  </section>
</PublicLayout>
