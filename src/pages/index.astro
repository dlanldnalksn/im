---
import PublicLayout from '../layouts/PublicLayout.astro';
import { publicOrgs } from '../data/organizations-public';
import { url } from '../lib/url';

const photoNews = [
  {
    tag: '연구·기술',
    title: '이능연구원, 차세대 생명력 파동 억제 기술 시연회 개최',
    desc: '조력자 없이도 일시적인 파동 억제가 가능한 신규 임상 기기를 대중에게 공개했습니다.',
    date: '2026.05.24',
    img: 'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=600&q=80',
    href: 'notices/',
  },
  {
    tag: '치안·안전',
    title: '특수감찰국, 수도권 훈련시설 일대 야간 합동 순찰 강화',
    desc: '미등재자 불법 접근 사례와 관련하여 야간 순찰 인력을 2배 확충했습니다.',
    date: '2026.05.21',
    img: 'https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=600&q=80',
    href: 'notices/',
  },
  {
    tag: '정책·행정',
    title: '제4차 국가 각성자 관리 및 복지 증진 기본계획 대국민 브리핑',
    desc: '조력자 매칭 시스템 효율화 및 안정원 시설 확충을 골자로 한 4차 기본계획을 발표했습니다.',
    date: '2026.05.18',
    img: 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=600&q=80',
    href: 'notices/',
  },
];

const notices = [
  { tag: 'important', label: '중요', org: '위원회', title: '신천 사건 15주기 추모일 안내 및 등재자 활동 제한 조치 시행', date: '2026.05.21', views: '8,492' },
  { tag: 'notice', label: '공지', org: '위원회', title: '「국가 각성자 관리 체계 요약 백서」 제 17.3 호 발간', date: '2026.05.14', views: '5,127' },
  { tag: 'notice', label: '공지', org: '조정원', title: '등재자 정기 검진 일정 및 처방 안내 (2분기)', date: '2026.05.02', views: '3,841' },
  { tag: 'admin', label: '행정', org: '중앙행정청', title: '등재자 신분증 갱신 절차 개정 안내 (시행일 6월 1일)', date: '2026.04.28', views: '6,205' },
  { tag: 'admin', label: '행정', org: '특수감찰국', title: '차출요원 4분기 배치 계획 공고', date: '2026.04.20', views: '12,084' },
  { tag: 'admin', label: '행정', org: '조정원', title: '2026년도 동기화 매칭 우선순위 산정 기준 개정 안내', date: '2026.04.11', views: '4,392' },
];

const boardItems = [
  { badge: '고시', alert: false, title: '이능관리법 제42조 시행령 일부개정안 입법예고', date: '2026.05.23' },
  { badge: '긴급', alert: true, title: '암시장 불법 조력자 매칭 제보 센터 한시적 운영 안내', date: '2026.05.22' },
  { badge: '채용', alert: false, title: '중앙행정청 및 이능연구원 상반기 연구·행정직 최종 합격자 발표', date: '2026.05.20' },
  { badge: '공지', alert: false, title: '[조정원] 부작용 면책 동의서(조정시술용) 법정 양식 업데이트', date: '2026.05.15' },
  { badge: '해명', alert: false, title: '특정 매체의 "보호처분소 수용률 초과" 보도는 사실이 아님을 밝힙니다', date: '2026.05.12' },
];

const quickLinks = [
  { icon: '登', label: '등재 신청', href: 'registration/' },
  { icon: '證', label: '신분증 갱신', href: 'registration/' },
  { icon: '居', label: '거주 이전', href: 'registration/' },
  { icon: '藥', label: '처방 안내', href: 'faq/', green: true },
  { icon: '同', label: '동기화 등록', href: 'registration/', green: true },
  { icon: '告', label: '미등재자 신고', href: 'faq/', dark: true },
];

const stats = [
  { label: '등재자 총원', icon: '人', iconBg: 'bg-[#eef4f8]', iconColor: 'text-[#1e4d6e]', value: '1,184,720', unit: '명', sub: '▲ 전년 대비 +2.3%', subGreen: true },
  { label: '능력자 비율', icon: '能', iconBg: 'bg-[#eef4f8]', iconColor: 'text-[#1e4d6e]', value: '2.1', unit: '%', sub: '전체 인구 대비', subGreen: false },
  { label: '조력자 비율', icon: '助', iconBg: 'bg-[#eef6ee]', iconColor: 'text-[#2d5f3f]', value: '0.34', unit: '%', sub: '능력자의 약 1/6', subGreen: false },
  { label: '매칭 완료 (누적)', icon: '同', iconBg: 'bg-[#ede8f0]', iconColor: 'text-[#5a3a7a]', value: '3,847', unit: '건', sub: '▲ 전년 대비 +148건', subGreen: true },
];
---

<PublicLayout title="홈">
  <!-- v2 분할 히어로 + Gemini 검색 -->
  <section class="imc-hero-split">
    <div class="imc-hero-main">
      <div class="imc-hero-badge">
        <span class="imc-hero-badge-dot"></span>
        FY 2026 정책 안내
      </div>
      <h2 class="imc-hero-title">
        함께 살아가는 사회를<br />
        위한 <span class="text-imc-primary">신뢰의 기반.</span>
      </h2>
      <p class="imc-hero-desc">
        이능관리위원회는 국무총리 직속 기관으로, 등재자의 안전한 사회 통합과 국민 보호를
        위해 산하 4개 기관과 함께 정책을 수립·시행합니다.
      </p>
      <div class="imc-hero-actions">
        <a href={url('about/')} class="imc-btn-primary">위원회 소개 <span class="text-[11px]">→</span></a>
        <a href={url('resources/')} class="imc-btn-outline">백서 다운로드</a>
      </div>
      <form class="imc-hero-search" role="search" action={url('faq/')} method="get">
        <input type="search" name="q" placeholder="검색어 (예: 등재자 갱신, 안정원 예약)" aria-label="통합검색" />
        <button type="submit">검색</button>
      </form>
    </div>

    <div class="imc-hero-spotlight">
      <div class="imc-hero-spotlight__wm" aria-hidden="true">異能</div>
      <div class="relative z-[2]">
        <p class="font-mono text-[10.5px] text-[#d4c8e8] tracking-[0.25em] mb-3 font-semibold">SHINCHEON · MEMORIAL DAY</p>
        <h3 class="text-[26px] lg:text-[30px] font-extrabold leading-tight mb-4 m-0">신천 사건 15주기<br />추모일 안내</h3>
        <p class="text-[13.5px] text-[#e8dcf5] leading-relaxed mb-7 max-w-[340px] m-0">
          2026년 5월 27일 전국 추모식 거행. 당일 전후 등재자 활동 제한 강화 조치가 시행됩니다.
        </p>
        <a href={url('notices/')} class="inline-flex items-center gap-4 px-[18px] py-3.5 bg-white/10 rounded-lg backdrop-blur-sm no-underline text-white max-w-[280px]">
          <span class="font-mono text-2xl font-extrabold">D-3</span>
          <span class="border-l border-white/20 pl-4">
            <span class="block text-[11px] text-[#d4c8e8] mb-0.5">2026.05.27 (수)</span>
            <span class="text-xs font-semibold">추모식 거행 →</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Gemini 포토 뉴스 -->
  <section class="px-6 lg:px-10 py-16 lg:py-20">
    <div class="imc-section-head">
      <h3 class="imc-section-head__title m-0">위원회 생생 현장</h3>
      <a href={url('notices/')} class="imc-section-head__more">보도자료 전체보기 +</a>
    </div>
    <div class="imc-photo-grid">
      {
        photoNews.map((item) => (
          <a href={url(item.href)} class="imc-photo-card">
            <img src={item.img} alt="" loading="lazy" />
            <div class="imc-photo-card__body">
              <span class="imc-photo-card__tag">{item.tag}</span>
              <h4 class="text-lg font-bold mb-3 leading-snug m-0">{item.title}</h4>
              <p class="text-sm text-imc-muted leading-relaxed m-0 line-clamp-2">{item.desc}</p>
              <span class="text-xs text-[#9ca3af] mt-4 block">{item.date}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- v2 산하 기관 2x2 -->
  <section class="px-6 lg:px-10 pb-16">
    <div class="imc-section-head imc-section-head--soft">
      <div>
        <p class="imc-section-head__eyebrow">SUBORDINATE AGENCIES</p>
        <h2 class="imc-section-head__title">산하 기관 안내</h2>
      </div>
      <a href={url('organizations/')} class="imc-section-head__more">조직도 전체보기 →</a>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {
        publicOrgs.map((org) => (
          <a href={url(org.href)} class:list={['imc-agency-wide', org.classified && 'is-classified']}>
            <div class:list={['imc-agency-wide__icon', org.iconBg, org.iconColor]}>{org.hanja}</div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2.5 mb-2">
                <span class="font-mono text-[10px] text-[#888] tracking-widest font-semibold">{org.num}</span>
                <span class="text-[11px] text-imc-muted">{org.codeEn}</span>
              </div>
              <h3 class="text-lg font-extrabold mb-1 tracking-tight">
                {org.name}
                <span class="text-xs text-[#888] font-medium font-serif ml-1">{org.nameHan}</span>
              </h3>
              <p class="text-[12.5px] text-imc-muted leading-relaxed mb-3.5 m-0">{org.desc}</p>
              <div class="flex gap-4 text-[11px] text-imc-muted border-t border-[#f0f0f2] pt-3">
                <span>{org.location}</span>
                <span class:list={['ml-auto font-bold imc-agency-wide__link', org.classified ? 'text-imc-danger' : 'text-imc-primary']}>
                  자세히 →
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- v2 민원 3칸 -->
  <section class="px-6 lg:px-10 pb-10">
    <div class="imc-service-row">
      <a href={url('registration/')} class="imc-service-card imc-service-card--brand">
        <div class="absolute -bottom-8 -right-4 font-serif text-[120px] text-white/[0.08] font-bold leading-none pointer-events-none">民</div>
        <p class="font-mono text-[10px] text-[#d4c8e8] tracking-[0.25em] mb-2.5 font-semibold relative">CIVIL APPLICATION</p>
        <h3 class="text-[22px] font-extrabold mb-2 relative">민원 신청</h3>
        <p class="text-xs text-[#d4c8e8] leading-relaxed mb-5 relative m-0">등재 · 갱신 · 이의신청 · 각종 허가</p>
        <span class="text-xs font-bold relative">신청 바로가기 →</span>
      </a>
      <a href={url('faq/')} class="imc-service-card">
        <p class="font-mono text-[10px] text-imc-danger tracking-[0.25em] mb-2.5 font-bold">REPORT</p>
        <h3 class="text-xl font-extrabold mb-2">미등재자 신고</h3>
        <p class="text-xs text-imc-muted leading-relaxed mb-5 m-0">익명 신고 가능 · 포상금 지급</p>
        <span class="text-xs text-imc-danger font-bold">신고하기 →</span>
      </a>
      <div class="imc-service-card">
        <p class="font-mono text-[10px] text-imc-primary tracking-[0.25em] mb-2.5 font-bold">INQUIRY</p>
        <h3 class="text-xl font-extrabold mb-2">상담 문의</h3>
        <p class="text-xs text-imc-muted leading-relaxed mb-3.5 m-0">평일 09:00 — 18:00</p>
        <p class="text-[15px] font-extrabold font-mono m-0">☎ 1551-0000</p>
      </div>
    </div>
  </section>

  <!-- v2 공지 2열 + Gemini 법령 고시 보드 -->
  <section class="px-6 lg:px-10 pb-16">
    <div class="imc-notice-board mb-10">
      <div class="imc-notice-board__tabs">
        <a href={url('notices/')} class="imc-notice-board__tab is-active">공지사항</a>
        <span class="imc-notice-board__tab">새소식</span>
        <span class="imc-notice-board__tab">보도자료</span>
        <span class="imc-notice-board__tab">채용공고</span>
        <a href={url('notices/')} class="ml-auto text-xs text-imc-muted py-[18px] font-semibold no-underline hover:underline">전체보기 +</a>
      </div>
      <div class="imc-notice-board__grid">
        {
          notices.map((n) => (
            <a href={url('notices/')} class="imc-notice-item">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class:list={['imc-tag', n.tag === 'important' && 'imc-tag--important', n.tag === 'notice' && 'imc-tag--notice', n.tag === 'admin' && 'imc-tag--admin']}>
                    {n.label}
                  </span>
                  <span class="text-[10.5px] text-[#888]">{n.org}</span>
                </div>
                <p class="text-[13.5px] font-semibold leading-snug m-0">{n.title}</p>
              </div>
              <div class="font-mono text-[11px] text-[#888] text-right shrink-0">
                <div>{n.date}</div>
                <div class="text-[10px] text-[#aaa] mt-0.5">조회 {n.views}</div>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div class="grid lg:grid-cols-[2fr_1fr] gap-8">
      <div>
        <div class="imc-section-head" style="margin-bottom: 1rem; padding-bottom: 0.75rem;">
          <h3 class="text-xl font-extrabold m-0">법령 고시 및 위원회 알림</h3>
        </div>
        <ul class="imc-board-list">
          {
            boardItems.map((item) => (
              <li>
                <a href={url('notices/')}>
                  <span class:list={['imc-board-badge', item.alert && 'alert']}>{item.badge}</span>
                  {item.title}
                </a>
                <span class="text-[13px] text-[#9ca3af] shrink-0">{item.date}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="imc-service-banner">
        <h4 class="text-xl font-bold mb-6 pb-3 border-b border-white/20 m-0">자주 찾는 통합 민원</h4>
        <div>
          <a href={url('registration/')}>신규 등재 및 신원증명 갱신</a>
          <a href={url('faq/')}>조정원 의무 진료·면회 예약</a>
          <a href={url('registration/')}>관외 (특구 외) 이동 및 출국 허가</a>
          <a href={url('registration/')}>훈련시설 모의 훈련 참관 신청</a>
          <a href={url('faq/')}>비인가 이상현상 익명 제보</a>
        </div>
      </div>
    </div>
  </section>

  <!-- v2 통계 -->
  <section class="imc-stat-section">
    <div class="imc-section-head imc-section-head--soft">
      <div>
        <p class="imc-section-head__eyebrow">STATISTICS 2025</p>
        <h2 class="imc-section-head__title">주요 통계 자료</h2>
      </div>
      <a href={url('resources/')} class="imc-section-head__more">통계 자료실 →</a>
    </div>
    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
      {
        stats.map((s) => (
          <div class="imc-stat-card">
            <div class="flex justify-between items-center mb-4">
              <p class="text-xs text-imc-muted font-semibold m-0">{s.label}</p>
              <div class:list={['w-7 h-7 rounded-md flex items-center justify-center font-serif text-xs font-bold', s.iconBg, s.iconColor]}>
                {s.icon}
              </div>
            </div>
            <p class="imc-stat-value m-0 mb-2">
              {s.value}<span class="text-sm text-[#888] font-bold ml-0.5">{s.unit}</span>
            </p>
            <p class:list={['text-[11.5px] m-0', s.subGreen ? 'text-[#2d5f3f] font-semibold' : 'text-imc-muted']}>{s.sub}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- v2 퀵링크 -->
  <section class="px-6 lg:px-10 py-16 border-t border-imc-border">
    <div class="mb-8">
      <p class="imc-section-head__eyebrow">QUICK LINKS</p>
      <h2 class="imc-section-head__title">자주 찾는 서비스</h2>
    </div>
    <div class="imc-quick-grid">
      {
        quickLinks.map((item) => (
          <a href={url(item.href)} class:list={['imc-quick-item', item.dark && 'imc-quick-item--dark']}>
            <div class:list={[
              'imc-quick-icon',
              item.green && 'bg-[#eef6ee] text-[#2d5f3f]',
              item.dark && 'bg-[rgba(139,42,42,0.2)] text-[#e88080]',
            ]}>
              {item.icon}
            </div>
            <span class="text-[12.5px] font-bold">{item.label}</span>
          </a>
        ))
      }
    </div>
  </section>
</PublicLayout>
