---
import PublicLayout from '../layouts/PublicLayout.astro';
import { publicNotices } from '../data/notices';
import { url } from '../lib/url';

const notices = [
  { badge: 'red', badgeLabel: '긴급', title: publicNotices[1]?.title ?? '신천사건 15주기 추모 행사 안내', date: '2026.05.24', href: 'notices/' },
  { badge: 'blue', badgeLabel: '안내', title: '2026년도 등재 신청 일정 안내', date: '2026.05.20', href: 'notices/' },
  { badge: '', badgeLabel: '', title: '조력자 매칭 대기 현황 (요약)', date: '2026.05.15', href: 'notices/' },
  { badge: '', badgeLabel: '', title: '차출 요원 3분기 정기 평가 일정 공고', date: '2026.05.10', href: 'notices/' },
  { badge: '', badgeLabel: '', title: '[추모] 신천 사건 15주기 관련, 등재자 다중밀집시설 출입 자제 권고', date: '2026.05.01', href: 'notices/' },
];
---

<PublicLayout title="홈">
  <!-- Gemini 히어로 + 퀵카드 -->
  <section class="gemini-hero pb-24 lg:pb-16">
    <h2 class="text-4xl lg:text-[48px] font-extrabold leading-tight tracking-tight mb-4 m-0">
      안전한 통제,<br />질서 있는 내일.
    </h2>
    <p class="text-lg font-light opacity-90 max-w-xl mb-0">
      이능관리위원회는 각성자의 체계적인 등재 관리와 안정적인 사회 정착을 지원하며, 국민의 안전을 최우선으로 생각합니다.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-auto pt-10 lg:absolute lg:bottom-[-40px] lg:w-[calc(100%-96px)] lg:px-0">
      <a href={url('registration/')} class="gemini-quick-card">
        <h3 class="text-lg font-bold mb-2 m-0">신규 등재 안내</h3>
        <p class="text-[13px] text-[#666] m-0">발현 시 14일 이내 의무 신고</p>
      </a>
      <a href={url('registration/')} class="gemini-quick-card">
        <h3 class="text-lg font-bold mb-2 m-0">거주·이동 허가</h3>
        <p class="text-[13px] text-[#666] m-0">관외 이동 및 출국 사전 승인</p>
      </a>
      <a href={url('registration/')} class="gemini-quick-card">
        <h3 class="text-lg font-bold mb-2 m-0">동기화 매칭 대기</h3>
        <p class="text-[13px] text-[#666] m-0">조정원 연계 매칭 순위 조회</p>
      </a>
      <a href={url('faq/')} class="gemini-quick-card danger">
        <h3 class="text-lg font-bold mb-2 m-0">이상현상·폭주 신고</h3>
        <p class="text-[13px] text-[#666] m-0">24시간 핫라인 (가상)</p>
      </a>
    </div>
  </section>

  <!-- Gemini 2단 본문 -->
  <section class="px-6 lg:px-12 pt-24 lg:pt-[100px] pb-16 flex flex-col lg:flex-row gap-10">
    <div class="flex-[2] min-w-0">
      <div class="gemini-section-title">
        <span>공지사항</span>
        <a href={url('notices/')} class="text-[13px] text-[#666] font-medium no-underline hover:underline">더보기 +</a>
      </div>
      <ul class="notice-list list-none m-0 p-0">
        {
          notices.map((n) => (
            <li class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 py-4 border-b border-[#eee]">
              <a href={url(n.href)} class="text-[15px] font-medium text-[#1a1a1a] no-underline hover:underline flex-1">
                {n.badge === 'red' && <span class="gemini-badge red">{n.badgeLabel}</span>}
                {n.badge === 'blue' && <span class="gemini-badge blue">{n.badgeLabel}</span>}
                {n.title}
              </a>
              <span class="font-mono text-[13px] text-[#999] shrink-0">{n.date}</span>
            </li>
          ))
        }
      </ul>

      <div class="gemini-whitepaper pl-6">
        <div class="font-mono text-xs text-[#666] tracking-widest mb-2.5">REPORT 202X-01 / 제 17.3 호 (공개용)</div>
        <div class="text-[22px] font-extrabold mb-2">국가 각성자 관리 체계 요약 백서</div>
        <div class="text-sm text-[#666] mb-5 leading-relaxed">
          신규 등재자의 제도 이해를 돕기 위한 공식 안내서입니다.<br />
          능력자/조력자 특성, 위험도 등급, 차출 의무 및 제한 사항이 포함되어 있습니다.
        </div>
        <a href={url('resources/')} class="gemini-btn-solid inline-block no-underline">전자문서 열람하기 →</a>
      </div>
    </div>

    <div class="flex-1 min-w-0">
      <div class="gemini-org-box">
        <h3 class="text-base font-bold mb-4 m-0">유관기관 바로가기</h3>
        <div class="org-links flex flex-col gap-2.5">
          <a href={url('organizations/')} class="flex justify-between items-center px-4 py-3 bg-[#fafaf7] border border-[#eee] text-sm font-semibold text-[#1a1a1a] no-underline hover:bg-[#eee]">
            조정원 (의료/매칭/안정원) <span>↗</span>
          </a>
          <a href={url('organizations/')} class="flex justify-between items-center px-4 py-3 bg-[#fafaf7] border border-[#eee] text-sm font-semibold text-[#1a1a1a] no-underline hover:bg-[#eee]">
            이녕연구원 (생명력/학술) <span>↗</span>
          </a>
          <a href={url('organizations/')} class="flex justify-between items-center px-4 py-3 bg-[#fafaf7] border border-[#eee] text-sm font-semibold text-[#1a1a1a] no-underline hover:bg-[#eee]">
            중앙행정청 관할 지역청 <span>↗</span>
          </a>
          <a href={url('faq/')} class="flex justify-between items-center px-4 py-3 bg-[#fafaf7] border border-[#f5c6c6] text-sm font-semibold text-[#8b2a2a] no-underline hover:bg-[#fdf0f0]">
            미등재자 신고 안내 <span>↗</span>
          </a>
        </div>
      </div>

      <div class="gemini-stat-box">
        <div class="stat-item mb-4 last:mb-0">
          <span class="block text-xs text-[#aaa] mb-1">전국 공식 등재자 현황 (추정치 제외)</span>
          <strong class="text-2xl font-mono font-normal">1,284,502 명</strong>
        </div>
        <div class="stat-item mb-4 last:mb-0">
          <span class="block text-xs text-[#aaa] mb-1">조력자 매칭 대기 인원</span>
          <strong class="text-2xl font-mono font-normal">1,053,211 명</strong>
        </div>
        <div class="stat-item mb-4 last:mb-0">
          <span class="block text-xs text-[#aaa] mb-1">금월 능력자 폭주/사건 접수</span>
          <strong class="text-2xl font-mono font-normal text-[#ffb3b3]">84 건</strong>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
