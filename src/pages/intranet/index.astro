---
import IntranetLayout from '../../layouts/IntranetLayout.astro';
import { internalNotices } from '../../data/notices';
import { allPersonnel } from '../../data/personnel';
import { url } from '../../lib/url';
---

<IntranetLayout title="대시보드">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">업무 대시보드</h1>
  <div class="grid md:grid-cols-3 gap-4 mb-8">
    <div class="card">
      <p class="text-xs text-slate-500">등록 인사 카드</p>
      <p class="text-3xl font-bold text-imc-navy mt-1">{allPersonnel.length}</p>
    </div>
    <div class="card">
      <p class="text-xs text-slate-500">내부 공지</p>
      <p class="text-3xl font-bold text-imc-navy mt-1">{internalNotices.length}</p>
    </div>
    <div class="card">
      <p class="text-xs text-slate-500">접속 등급</p>
      <p class="text-lg font-bold text-slate-800 mt-1">일반 직원</p>
    </div>
  </div>
  <div class="grid md:grid-cols-2 gap-6">
    <section class="card">
      <h2 class="font-bold mb-3">빠른 링크</h2>
      <ul class="space-y-2 text-sm">
        <li><a href={url('intranet/personnel/')} class="text-imc-accent hover:underline">인사 통합 조회</a></li>
        <li><a href={url('intranet/organizations/')} class="text-imc-accent hover:underline">전체 조직도</a></li>
        <li><a href={url('intranet/documents/')} class="text-imc-accent hover:underline">내부 자료실</a></li>
      </ul>
    </section>
    <section class="card">
      <h2 class="font-bold mb-3">내부 공지</h2>
      <ul class="space-y-3 text-sm">
        {
          internalNotices.map((n) => (
            <li>
              <span class="text-slate-400 text-xs">{n.date}</span>
              <p class="font-medium">{n.title}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</IntranetLayout>
