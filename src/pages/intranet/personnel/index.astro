---
import IntranetLayout from '../../../layouts/IntranetLayout.astro';
import { allPersonnel } from '../../../data/personnel';
import { url } from '../../../lib/url';
---

<IntranetLayout title="인사 조회">
  <h1 class="text-2xl font-bold mb-2">인사 통합 조회</h1>
  <p class="text-sm text-slate-600 mb-6">등재자·소속 요원 인사 카드 · 대외비</p>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      allPersonnel.map((p) => (
        <a href={url(`intranet/personnel/${p.id}`)} class="card hover:border-imc-accent transition-colors block">
          <div class="flex justify-between items-start">
            <div>
              <h2 class="text-lg font-bold">{p.name}</h2>
              <p class="text-sm text-slate-500">{p.nameEn}</p>
            </div>
            {p.registry.abilityGrade && (
              <span class="text-xs font-bold bg-imc-navy text-white px-2 py-0.5 rounded">
                {p.registry.abilityGrade}
              </span>
            )}
          </div>
          <p class="mt-2 text-sm text-slate-600">
            {p.org} · {p.department}
          </p>
          <p class="text-sm text-slate-500">{p.role}</p>
          <div class="mt-3 flex flex-wrap gap-1">
            {p.tags.map((t) => (
              <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">{t}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</IntranetLayout>
