---
import IntranetLayout from '../../../layouts/IntranetLayout.astro';
import { intranetPortals, getPortalById } from '../../../data/intranet-portals';
import { getNoticesForPortal, getPersonnelForPortal, getDocumentsForPortal } from '../../../lib/intranet-content';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return intranetPortals.map((p) => ({ params: { portal: p.id } }));
}

const { portal: portalId } = Astro.params;
const portal = getPortalById(portalId!);

if (!portal) {
  return Astro.redirect(url('intranet/login/'));
}

const notices = getNoticesForPortal(portal.id);
const personnel = getPersonnelForPortal(portal.id);
const documents = getDocumentsForPortal(portal.id);
const base = `intranet/${portal.id}/`;
---

<IntranetLayout title="대시보드" portal={portal}>
  <p class="font-mono text-[10px] text-imc-muted tracking-widest mb-1">{portal.code} · DASHBOARD</p>
  <h1 class="text-2xl font-extrabold tracking-tight mb-2">{portal.name} 업무 대시보드</h1>
  <p class="text-sm text-imc-muted mb-8">{portal.banner}</p>

  <div class="grid md:grid-cols-3 gap-4 mb-8">
    <div class="border border-imc-border p-5 bg-[#f8f9fb]">
      <p class="text-xs text-imc-muted mb-1">소속 인사 카드</p>
      <p class="text-3xl font-extrabold" style={`color: ${portal.accent}`}>{personnel.length}</p>
    </div>
    <div class="border border-imc-border p-5 bg-[#f8f9fb]">
      <p class="text-xs text-imc-muted mb-1">내부 공지</p>
      <p class="text-3xl font-extrabold" style={`color: ${portal.accent}`}>{notices.length}</p>
    </div>
    <div class="border border-imc-border p-5 bg-[#f8f9fb]">
      <p class="text-xs text-imc-muted mb-1">접속 등급</p>
      <p class="text-lg font-bold">{portal.clearanceLabel}</p>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <section class="border border-imc-border p-5">
      <h2 class="font-bold mb-4 pb-2 border-b border-imc-border">빠른 링크</h2>
      <ul class="space-y-2 text-sm">
        <li><a href={url(`${base}personnel/`)} class="font-semibold hover:underline" style={`color: ${portal.accent}`}>인사 조회 →</a></li>
        <li><a href={url(`${base}organizations/`)} class="font-semibold hover:underline" style={`color: ${portal.accent}`}>조직도 →</a></li>
        <li><a href={url(`${base}documents/`)} class="font-semibold hover:underline" style={`color: ${portal.accent}`}>내부 자료실 →</a></li>
      </ul>
      {
        portal.id !== 'imc' && (
          <p class="mt-4 text-xs text-imc-muted border-t border-imc-border pt-3">
            타 산하 기관 내부망은 별도 인증 필요. 본청 통합망(IMC)과 데이터가 분리되어 있습니다.
          </p>
        )
      }
    </section>
    <section class="border border-imc-border p-5">
      <h2 class="font-bold mb-4 pb-2 border-b border-imc-border">내부 공지</h2>
      <ul class="space-y-3 text-sm">
        {
          notices.length === 0 ? (
            <li class="text-imc-muted">등록된 공지가 없습니다.</li>
          ) : (
            notices.map((n) => (
              <li class="border-b border-[#f0f1f3] pb-2 last:border-0">
                <span class="font-mono text-[11px] text-imc-muted">{n.date.replace(/-/g, '.')}</span>
                <p class="font-medium mt-0.5">{n.title}</p>
              </li>
            ))
          )
        }
      </ul>
    </section>
  </div>

  {
    documents.length > 0 && (
      <section class="border border-imc-border p-5 mt-6">
        <h2 class="font-bold mb-3">최근 열람 가능 자료</h2>
        <ul class="text-sm space-y-2">
          {documents.filter((d) => d.accessible).slice(0, 3).map((d) => (
            <li class="flex justify-between gap-2">
              <span>{d.title}</span>
              <span class="text-xs text-imc-muted shrink-0">{d.meta}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</IntranetLayout>
