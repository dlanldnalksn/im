---
import IntranetLayout from '../../../../layouts/IntranetLayout.astro';
import SibIntranetLayout from '../../../../layouts/SibIntranetLayout.astro';
import SibPersonnelProfile from '../../../../components/sib/SibPersonnelProfile.astro';
import { intranetPortals, getPortalById } from '../../../../data/intranet-portals';
import { allPersonnel, getPersonnelById } from '../../../../data/personnel';
import { canViewPersonnel } from '../../../../lib/intranet-content';
import { url } from '../../../../lib/url';

export function getStaticPaths() {
  const paths: { params: { portal: string; id: string } }[] = [];
  for (const portal of intranetPortals) {
    for (const person of allPersonnel) {
      if (person.portalId === portal.id) {
        paths.push({ params: { portal: portal.id, id: person.id } });
      }
    }
  }
  return paths;
}

const { portal: portalId, id } = Astro.params;
const portal = getPortalById(portalId!);
const person = getPersonnelById(id!);
const base = `intranet/${portalId}/`;
const isSib = portal?.id === 'sib';

if (!portal || !person || !canViewPersonnel(person, portal.id)) {
  return Astro.redirect(url(`${base}personnel/`));
}

const Layout = isSib ? SibIntranetLayout : IntranetLayout;
---

{
  isSib ? (
    <SibIntranetLayout title="신상·인사">
      <SibPersonnelProfile />
    </SibIntranetLayout>
  ) : (
    <Layout title={person.name} portal={portal}>
      <nav class="text-sm text-slate-500 mb-4">
        <a href={url(`${base}personnel/`)} class="hover:text-imc-accent">인사 조회</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800">{person.name}</span>
      </nav>

      <header class="card mb-6">
        <div class="flex flex-wrap justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold">{person.name}</h1>
            <p class="text-slate-500">{person.nameEn} · {person.age}세 · {person.sex === 'M' ? '남' : '여'}</p>
            <p class="mt-2 text-sm">
              <span class="font-semibold">{person.org}</span> · {person.department} · {person.role}
            </p>
            <p class="text-xs text-slate-400 mt-1">사번 {person.employeeId}</p>
          </div>
        </div>
      </header>
    </Layout>
  )
}
