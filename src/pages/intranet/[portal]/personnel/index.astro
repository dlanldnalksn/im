---
import IntranetLayout from '../../../../layouts/IntranetLayout.astro';
import SibIntranetLayout from '../../../../layouts/SibIntranetLayout.astro';
import { intranetPortals, getPortalById } from '../../../../data/intranet-portals';
import { getPersonnelForPortal } from '../../../../lib/intranet-content';
import { url } from '../../../../lib/url';

export function getStaticPaths() {
  return intranetPortals.map((p) => ({ params: { portal: p.id } }));
}

const { portal: portalId } = Astro.params;
const portal = getPortalById(portalId!);

if (!portal) {
  return Astro.redirect(url('intranet/login/'));
}

const isSib = portal.id === 'sib';
const personnel = getPersonnelForPortal(portal.id);
const base = `intranet/${portal.id}/`;
const Layout = isSib ? SibIntranetLayout : IntranetLayout;
const pageTitle = isSib ? '신상·인사' : '인사 조회';
---

<Layout title={pageTitle} portal={portal}>
  <h1 class:list={['font-extrabold mb-2', isSib ? 'text-[22px] tracking-tight' : 'text-2xl font-bold']}>
    {pageTitle}
  </h1>
  <p class:list={['mb-6', isSib ? 'text-[13px] text-imc-muted' : 'text-sm text-slate-600']}>
    {portal.name} 소속 · 대외비
  </p>

  {
    personnel.length === 0 ? (
      <div class:list={['text-sm text-imc-muted', !isSib && 'card']}>
        <p>이 내부망에 등록된 인사 카드가 없습니다.</p>
        {
          portal.id === 'imc' && (
            <p class="mt-2">산하 기관 인사는 각 기관 코드로 로그인하여 조회하세요.</p>
          )
        }
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {
          personnel.map((p) => (
            <a
              href={url(`${base}personnel/${p.id}/`)}
              class:list={[
                'block no-underline text-inherit transition-colors',
                isSib
                  ? 'sib-panel p-[22px] hover:border-imc-danger/40'
                  : 'card hover:border-imc-accent',
              ]}
            >
              <div class="flex justify-between items-start">
                <div>
                  <h2 class:list={['font-bold', isSib ? 'text-[15px]' : 'text-lg']}>{p.name}</h2>
                  <p class="text-sm text-slate-500">{p.nameEn}</p>
                </div>
                {
                  p.registry.abilityGrade && (
                    <span class:list={[
                      'text-xs font-bold px-2 py-0.5 rounded shrink-0',
                      isSib ? 'sib-tag red' : 'bg-imc-navy text-white',
                    ]}>
                      {p.registry.abilityGrade}
                    </span>
                  )
                }
              </div>
              <p class="mt-2 text-sm text-slate-600">
                {p.org} · {p.department}
              </p>
              <p class="text-sm text-slate-500">{p.role}</p>
            </a>
          ))
        }
      </div>
    )
  }
</Layout>
