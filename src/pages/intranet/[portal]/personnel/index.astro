---
import IntranetLayout from '../../../../layouts/IntranetLayout.astro';
import { intranetPortals, getPortalById } from '../../../../data/intranet-portals';
import { getPersonnelForPortal } from '../../../../lib/intranet-content';
import { url } from '../../../../lib/url';

export function getStaticPaths() {
  return intranetPortals.map((p) => ({ params: { portal: p.id } }));
}

const { portal: portalId } = Astro.params;
const portal = getPortalById(portalId!);

if (!portal) {
  return Astro.redirect(url('intranet/login/'));
}

const personnel = getPersonnelForPortal(portal.id);
const base = `intranet/${portal.id}/`;
---

<IntranetLayout title="인사 조회" portal={portal}>
  <h1 class="text-2xl font-bold mb-2">인사 조회</h1>
  <p class="text-sm text-slate-600 mb-6">{portal.name} 소속 · 대외비</p>

  {
    personnel.length === 0 ? (
      <div class="card text-sm text-imc-muted">
        <p>이 내부망에 등록된 인사 카드가 없습니다.</p>
        {
          portal.id === 'imc' && (
            <p class="mt-2">산하 기관 인사는 각 기관 코드로 로그인하여 조회하세요.</p>
          )
        }
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {
          personnel.map((p) => (
            <a href={url(`${base}personnel/${p.id}/`)} class="card hover:border-imc-accent transition-colors block">
              <div class="flex justify-between items-start">
                <div>
                  <h2 class="text-lg font-bold">{p.name}</h2>
                  <p class="text-sm text-slate-500">{p.nameEn}</p>
                </div>
                {
                  p.registry.abilityGrade && (
                    <span class="text-xs font-bold bg-imc-navy text-white px-2 py-0.5 rounded">
                      {p.registry.abilityGrade}
                    </span>
                  )
                }
              </div>
              <p class="mt-2 text-sm text-slate-600">
                {p.org} · {p.department}
              </p>
              <p class="text-sm text-slate-500">{p.role}</p>
              <div class="mt-3 flex flex-wrap gap-1">
                {p.tags.map((t) => (
                  <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">{t}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    )
  }
</IntranetLayout>
