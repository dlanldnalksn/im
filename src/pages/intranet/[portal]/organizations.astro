---
import IntranetLayout from '../../../layouts/IntranetLayout.astro';
import { intranetPortals, getPortalById } from '../../../data/intranet-portals';
import { getOrgChartSections } from '../../../lib/intranet-content';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return intranetPortals.map((p) => ({ params: { portal: p.id } }));
}

const { portal: portalId } = Astro.params;
const portal = getPortalById(portalId!);

if (!portal) {
  return Astro.redirect(url('intranet/login/'));
}

const sections = getOrgChartSections(portal);
---

<IntranetLayout title="조직도" portal={portal}>
  <h1 class="text-2xl font-bold mb-2">조직도</h1>
  <p class="text-sm text-slate-600 mb-8">{portal.name} · 대외비 · 무단 유출 금지</p>

  {
    portal.id === 'imc' && (
      <div class="card mb-6">
        <h2 class="text-lg font-bold text-imc-navy">이능관리위원회</h2>
        <p class="text-sm text-slate-600 mt-1">국무총리 직속 · 산하 4개 기관</p>
        <p class="text-xs text-imc-muted mt-2">기관별 상세 조직도·인사는 각 산하 내부망에서만 열람 가능합니다.</p>
      </div>
    )
  }

  <div class="grid gap-4">
    {
      sections.map((org) => (
        <article class:list={['card', org.restricted && 'border-imc-alert/30 bg-red-50/20']}>
          <h3 class:list={['font-bold', org.restricted && 'text-imc-alert']}>{org.name}</h3>
          <p class="text-sm text-slate-600 mt-1">{org.desc}</p>
          {'note' in org && org.note && <p class="text-xs text-imc-muted mt-2">{org.note}</p>}
          {'detail' in org && org.detail && (
            <ul class="mt-3 text-sm space-y-1 text-slate-700">
              {org.detail.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</IntranetLayout>
