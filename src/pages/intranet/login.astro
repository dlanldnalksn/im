---
import '../../styles/global.css';
import { url } from '../../lib/url';

const password = import.meta.env.PUBLIC_INTRANET_PASSWORD || 'imc-intra';
const homeUrl = url();
const intranetUrl = url('intranet/');
const loginPath = url('intranet/login/');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>내부망 로그인 | 이능관리위원회</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#1a1a1a] flex items-center justify-center p-4 font-sans">
    <div class="w-full max-w-md bg-white border border-[#d0d0d0] shadow-2xl p-8">
      <p class="font-mono text-[10px] text-imc-danger font-bold text-center tracking-widest mb-2">INTERNAL ACCESS</p>
      <h1 class="text-xl font-extrabold text-center tracking-tight">내부망 로그인</h1>
      <p class="text-sm text-imc-muted text-center mt-2 mb-6">이능관리위원회 통합 인증</p>
      <form id="login-form" class="space-y-4">
        <div>
          <label for="employee-id" class="block text-xs font-semibold text-imc-ink mb-1">사번</label>
          <input
            id="employee-id"
            type="text"
            class="w-full border border-[#d0d3d9] px-3 py-2.5 text-sm outline-none focus:border-imc-primary"
            placeholder="TG-0-00-0000"
            autocomplete="username"
          />
        </div>
        <div>
          <label for="password" class="block text-xs font-semibold text-imc-ink mb-1">비밀번호</label>
          <input
            id="password"
            type="password"
            class="w-full border border-[#d0d3d9] px-3 py-2.5 text-sm outline-none focus:border-imc-primary"
            autocomplete="current-password"
            required
          />
        </div>
        <p id="login-error" class="text-sm text-imc-danger hidden">인증에 실패했습니다.</p>
        <button type="submit" class="w-full bg-imc-ink text-white py-3 text-sm font-bold hover:bg-[#333] transition-colors">
          로그인
        </button>
      </form>
      <p class="mt-6 text-center">
        <a href={homeUrl} class="text-xs text-imc-muted hover:text-imc-ink">← 대외 누리집</a>
      </p>
    </div>
    <script define:vars={{ password, intranetUrl, loginPath }}>
      const form = document.getElementById('login-form');
      const err = document.getElementById('login-error');
      if (sessionStorage.getItem('imc_intranet_auth') === '1') {
        window.location.replace(intranetUrl);
      }
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const pw = document.getElementById('password')?.value;
        if (pw === password) {
          sessionStorage.setItem('imc_intranet_auth', '1');
          window.location.href = intranetUrl;
        } else {
          err?.classList.remove('hidden');
        }
      });
    </script>
  </body>
</html>
