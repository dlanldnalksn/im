---
import '../../styles/global.css';
import { url } from '../../lib/url';
import { intranetPortals } from '../../data/intranet-portals';

const homeUrl = url();
const loginPath = url('intranet/login/');
const portalConfigs = intranetPortals.map((p) => ({
  id: p.id,
  code: p.code,
  name: p.name,
  prefix: p.employeePrefix,
  password: p.password,
  accent: p.accent,
}));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href={import.meta.env.BASE_URL} />
    <meta name="robots" content="noindex, nofollow" />
    <title>내부망 로그인 | 이능관리위원회</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#1a1a1a] font-sans flex flex-col">
    <div class="flex flex-1 items-center justify-center p-4">
    <div class="w-full max-w-lg bg-white border border-[#d0d0d0] shadow-2xl p-8">
      <p class="font-mono text-[10px] text-imc-danger font-bold text-center tracking-widest mb-2">INTERNAL ACCESS</p>
      <h1 class="text-xl font-extrabold text-center tracking-tight">산하 기관 내부망 로그인</h1>
      <p class="text-sm text-imc-muted text-center mt-2 mb-6">
        기관 코드·사번·비밀번호에 따라 접속 포털이 분리됩니다.
      </p>

      <form id="login-form" class="space-y-4">
        <div>
          <label for="org-code" class="block text-xs font-semibold text-imc-ink mb-1">기관 코드</label>
          <select
            id="org-code"
            class="w-full border border-[#d0d3d9] px-3 py-2.5 text-sm outline-none focus:border-imc-primary bg-white"
          >
            <option value="">— 사번으로 자동 판별 —</option>
            {
              intranetPortals.map((p) => (
                <option value={p.code}>
                  {p.code} · {p.name}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="employee-id" class="block text-xs font-semibold text-imc-ink mb-1">사번</label>
          <input
            id="employee-id"
            type="text"
            class="w-full border border-[#d0d3d9] px-3 py-2.5 text-sm outline-none focus:border-imc-primary font-mono"
            placeholder="SIB-2-08-0147"
            autocomplete="username"
          />
          <p class="text-[11px] text-imc-muted mt-1">예: TG-0(본청), TG-2(특감국), CA-/AD-/IR-(산하)</p>
        </div>
        <div>
          <label for="password" class="block text-xs font-semibold text-imc-ink mb-1">비밀번호</label>
          <input
            id="password"
            type="password"
            class="w-full border border-[#d0d3d9] px-3 py-2.5 text-sm outline-none focus:border-imc-primary"
            autocomplete="current-password"
            required
          />
        </div>
        <p id="login-error" class="text-sm text-imc-danger hidden">기관·사번·비밀번호를 확인하세요.</p>
        <button type="submit" class="w-full bg-imc-ink text-white py-3 text-sm font-bold hover:bg-[#333] transition-colors">
          해당 내부망 접속
        </button>
      </form>

      <details class="mt-6 border border-[#e8e8e8] p-3 text-xs text-imc-muted">
        <summary class="cursor-pointer font-semibold text-imc-ink">데모 접속 정보 (RP용)</summary>
        <ul class="mt-2 space-y-1 font-mono">
          {
            intranetPortals.map((p) => (
              <li>
                <span style={`color: ${p.accent}`}>{p.code}</span> · {p.employeePrefix}… · {p.password}
              </li>
            ))
          }
        </ul>
      </details>

      <p class="mt-6 text-center">
        <a href={homeUrl} class="text-xs text-imc-muted hover:text-imc-ink">← 대외 누리집</a>
      </p>
    </div>
    </div>
    <script define:vars={{ portalConfigs, loginPath }}>
      const form = document.getElementById('login-form');
      const err = document.getElementById('login-error');

      const storedPortal = sessionStorage.getItem('imc_intranet_portal');
      if (sessionStorage.getItem('imc_intranet_auth') === '1' && storedPortal) {
        window.location.replace(`${loginPath.replace(/login\/?$/, '')}${storedPortal}/`);
      }

      function resolve(orgCode, employeeId, password) {
        const code = orgCode.trim().toUpperCase();
        const emp = employeeId.trim().toUpperCase();
        const byCode = code ? portalConfigs.find((p) => p.code === code) : null;
        const byEmp = emp ? portalConfigs.find((p) => emp.startsWith(p.prefix.toUpperCase())) : null;
        const portal = byCode || byEmp;
        if (!portal || password !== portal.password) return null;
        if (byCode && byEmp && byCode.id !== byEmp.id) return null;
        return portal;
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        err?.classList.add('hidden');
        const orgCode = document.getElementById('org-code')?.value || '';
        const employeeId = document.getElementById('employee-id')?.value || '';
        const password = document.getElementById('password')?.value || '';
        const portal = resolve(orgCode, employeeId, password);
        if (portal) {
          sessionStorage.setItem('imc_intranet_auth', '1');
          sessionStorage.setItem('imc_intranet_portal', portal.id);
          const base = loginPath.replace(/login\/?$/, '');
          window.location.href = `${base}${portal.id}/`;
        } else {
          err?.classList.remove('hidden');
        }
      });
    </script>
  </body>
</html>
