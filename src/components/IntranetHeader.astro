---
import { url, pathnameEquals, pathnameStartsWith } from '../lib/url';

const nav = [
  { path: 'intranet/', label: '대시보드', exact: true },
  { path: 'intranet/organizations/', label: '조직도' },
  { path: 'intranet/personnel/', label: '인사 조회' },
  { path: 'intranet/documents/', label: '내부 자료' },
];
const pathname = Astro.url.pathname;
---

<header class="border-b border-slate-700 bg-slate-900 text-white">
  <div class="bg-imc-alert text-white text-center text-xs py-1 font-medium">
    직원 전용 내부망 · 무단 접근·유출 금지 · 접속 기록 보관
  </div>
  <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-xs text-slate-400 uppercase tracking-wider">Internal Network</p>
      <p class="text-lg font-bold">이능관리위원회 내부망</p>
    </div>
    <nav class="flex flex-wrap gap-1 text-sm">
      {
        nav.map((item) => {
          const active = item.exact
            ? pathnameEquals(pathname, item.path)
            : pathnameStartsWith(pathname, item.path);
          return (
            <a
              href={url(item.path)}
              class:list={[
                'px-3 py-1.5 rounded',
                active ? 'bg-white/15 font-semibold' : 'text-slate-300 hover:bg-white/10',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={url('intranet/logout/')}
        class="px-3 py-1.5 rounded text-slate-400 hover:text-white hover:bg-white/10"
      >
        로그아웃
      </a>
    </nav>
  </div>
</header>
