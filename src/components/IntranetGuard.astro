---
import { url } from '../lib/url';

interface Props {
  portalId: string;
}

const { portalId } = Astro.props;
const loginPath = url('intranet/login/');
---

<script define:vars={{ loginPath, portalId }}>
  (function () {
    const auth = sessionStorage.getItem('imc_intranet_auth');
    const stored = sessionStorage.getItem('imc_intranet_portal');
    if (auth !== '1' || stored !== portalId) {
      window.location.replace(loginPath);
    }
  })();
</script>
