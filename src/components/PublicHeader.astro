---
import { url, pathnameEquals, pathnameStartsWith } from '../lib/url';

const nav = [
  { path: '', label: '홈' },
  { path: 'about/', label: '제도 안내' },
  { path: 'registration/', label: '등재 민원' },
  { path: 'organizations/', label: '조직 소개' },
  { path: 'notices/', label: '알림마당' },
  { path: 'faq/', label: 'FAQ' },
  { path: 'resources/', label: '자료실' },
];
const pathname = Astro.url.pathname;
---

<header class="gemini-header">
  <a href={url()} class="logo flex items-center gap-3 no-underline text-inherit shrink-0">
    <div class="gemini-logo-mark"></div>
    <div class="logo-text">
      <h1 class="text-[22px] font-extrabold tracking-tight leading-tight m-0">이능관리위원회</h1>
      <p class="text-[11px] text-[#666] font-mono tracking-widest m-0 mt-0.5">국무총리 직속</p>
    </div>
  </a>

  <nav class="gemini-nav" aria-label="주 메뉴">
    <ul class="list-none flex flex-wrap gap-x-9 gap-y-2 m-0 p-0">
      {
        nav.map((item) => {
          const active =
            pathnameEquals(pathname, item.path) ||
            (item.path !== '' && pathnameStartsWith(pathname, item.path));
          return (
            <li>
              <a
                href={url(item.path)}
                class:list={[active && 'text-[#3478f6]']}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="auth-btns flex flex-wrap gap-2 shrink-0">
    <a href={url('registration/')} class="gemini-btn-outline">등재자 로그인</a>
    <a href={url('intranet/login/')} class="gemini-btn-solid">직원 내부망</a>
  </div>
</header>
