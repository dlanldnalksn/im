---
import { url, pathnameEquals, pathnameStartsWith } from '../lib/url';

const nav = [
  { path: '', label: '홈' },
  { path: 'about/', label: '위원회 소개' },
  { path: 'about/', label: '정책·제도' },
  { path: 'registration/', label: '민원·신고' },
  { path: 'resources/', label: '정보공개' },
  { path: 'notices/', label: '알림·소식' },
];

const pathname = Astro.url.pathname;

function isActive(item: (typeof nav)[0]) {
  if (item.path === '') return pathnameEquals(pathname, '');
  return pathnameStartsWith(pathname, item.path);
}
---

<header>
  <div class="imc-util-bar">
    <div class="imc-util-bar__inner">
      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1">
        <span class="imc-util-muted">「각성자 관리 체계」 가상 세계관 누리집</span>
        <span class="imc-util-sep">|</span>
        <span>창작·롤플레이 설정용</span>
        <span class="imc-util-sep hidden sm:inline">|</span>
        <a href={url('about/')} class="hidden sm:inline imc-util-muted hover:!text-white">세계관 안내</a>
      </div>
      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1">
        <a href={url('registration/')}>등재자 로그인</a>
        <span class="imc-util-sep">|</span>
        <a href={url('intranet/login/')}>직원 내부망</a>
        <span class="imc-util-sep hidden sm:inline">|</span>
        <a href={url('faq/')} class="hidden sm:inline">전체메뉴</a>
      </div>
    </div>
  </div>

  <div class="imc-main-header">
    <a href={url()} class="imc-logo">
      <div class="imc-logo-mark">異</div>
      <div>
        <div class="text-[16.5px] font-bold tracking-tight leading-tight">이능관리위원회</div>
        <div class="text-[10.5px] text-imc-muted font-serif mt-0.5">
          異能管理委員會 · Power Management Committee
        </div>
      </div>
    </a>

    <nav class="imc-gnb hidden xl:flex" aria-label="주 메뉴">
      {
        nav.map((item, i) => {
          if (i === 2) return null;
          return (
            <a href={url(item.path)} class:list={['imc-gnb-link', isActive(item) && 'is-active']}>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <form class="imc-search hidden md:flex" role="search" action={url('faq/')} method="get">
      <input type="search" name="q" placeholder="통합검색" aria-label="통합검색" />
      <button type="submit" aria-label="검색">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="#666" stroke-width="2"></circle>
          <path d="M21 21l-4-4" stroke="#666" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>
  </div>

  <nav class="xl:hidden border-t border-imc-border px-4 py-2 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold" aria-label="주 메뉴">
    {
      nav.map((item, i) => {
        if (i === 2) return null;
        return (
          <a href={url(item.path)} class:list={['text-imc-ink no-underline', isActive(item) && 'text-imc-primary']}>
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>
