---
import { url } from '../../lib/url';
import {
  SIB_OP_PAGE_SIZE,
  SIB_OP_REFERENCE_DATE,
  sibOperationStats,
  sibOperationRecords,
} from '../../data/sib-operations-list';
import type { SibOpStatusTag, SibOperationRecord } from '../../data/sib-operations-list';

const base = 'intranet/sib/';
const updated = '2026.05.24 14:22';

const statCards = [
  { label: '전체', value: sibOperationStats.total, filter: 'all', accent: false },
  { label: '미열람', value: sibOperationStats.unread, filter: 'unread', accent: true },
  { label: '진행 중', value: sibOperationStats.inProgress, filter: 'progress', accent: false },
  { label: '완료', value: sibOperationStats.done, filter: 'done', accent: false },
  { label: '반려·취소', value: sibOperationStats.rejected, filter: 'rejected', accent: false, muted: true },
];

const filterTabs = [
  { label: '전체', filter: 'all' },
  { label: '미열람', filter: 'unread' },
  { label: '진행 중', filter: 'progress' },
  { label: '완료', filter: 'done' },
  { label: '반려·취소', filter: 'rejected' },
];

const categoryOptions = ['전체', ...new Set(sibOperationRecords.map((op) => op.category))];

const periodOptions = [
  { label: '최근 3개월', value: '3m' },
  { label: '최근 6개월', value: '6m' },
  { label: '전체', value: 'all' },
];

function tagClass(tag: SibOpStatusTag) {
  if (tag.variant === 'red') return 'sib-tag red';
  if (tag.variant === 'amber') return 'sib-tag amber';
  if (tag.variant === 'gray') return 'sib-tag gray';
  if (tag.variant === 'unread') return 'sib-op-tag-unread';
  return 'sib-op-tag-rejected';
}

function rowClass(op: SibOperationRecord) {
  if (op.rowStyle === 'priority') return 'sib-op-table-row priority';
  if (op.rowStyle === 'urgent') return 'sib-op-table-row urgent';
  return 'sib-op-table-row';
}
---

<nav class="sib-breadcrumb" aria-label="경로">
  <a href={url(`${base}`)} class="sib-breadcrumb-link">대시보드</a>
  <span class="sib-breadcrumb-sep">›</span>
  <span class="sib-breadcrumb-current">작전 명령</span>
</nav>

<div class="sib-page-head">
  <div>
    <h1 class="sib-page-title">작전 명령 목록</h1>
    <p class="sib-page-subtitle">본인 차출 명령 및 작전 이력</p>
  </div>
  <div class="sib-page-meta">최근 갱신 {updated}</div>
</div>

<div class="sib-op-stat-grid" data-sib-op-stats>
  {
    statCards.map((s) => (
      <button
        type="button"
        class:list={['sib-op-stat-card', s.accent && 'accent', s.muted && 'muted']}
        data-sib-op-stat-filter={s.filter}
      >
        <div class:list={['sib-op-stat-label', s.accent && 'accent']}>{s.label}</div>
        <div class="sib-op-stat-value">
          {s.value}<span class="sib-op-stat-unit">건</span>
        </div>
      </button>
    ))
  }
</div>

<div class="sib-op-toolbar" data-sib-op-toolbar>
  <div class="sib-op-filter-tabs" role="tablist" aria-label="작전 명령 필터">
    {
      filterTabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          class:list={['sib-op-filter-tab', i === 0 && 'is-active']}
          data-sib-op-filter={tab.filter}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div class="sib-op-toolbar-right">
    <label class="sib-op-select">
      <span class="sib-op-select-label">분류</span>
      <select class="sib-op-select-native" data-sib-op-category aria-label="분류 필터">
        {
          categoryOptions.map((cat) => (
            <option value={cat === '전체' ? 'all' : cat}>{cat}</option>
          ))
        }
      </select>
      <span class="sib-op-select-caret" aria-hidden="true">▾</span>
    </label>
    <label class="sib-op-select">
      <span class="sib-op-select-label">기간</span>
      <select class="sib-op-select-native" data-sib-op-period aria-label="기간 필터">
        {
          periodOptions.map((opt) => (
            <option value={opt.value} selected={opt.value === '3m'}>
              {opt.label}
            </option>
          ))
        }
      </select>
      <span class="sib-op-select-caret" aria-hidden="true">▾</span>
    </label>
    <label class="sib-op-search">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="#888" stroke-width="2"></circle>
        <path d="M21 21l-4-4" stroke="#888" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        class="sib-op-search-input"
        data-sib-op-search
        placeholder="작전번호 / 키워드"
        aria-label="작전번호 또는 키워드 검색"
      />
    </label>
  </div>
</div>

<div class="sib-op-table-wrap" data-sib-op-list>
  <div class="sib-op-table">
    <div class="sib-op-table-head">
      <div>상태</div>
      <div>분류</div>
      <div>작전번호</div>
      <div>건명</div>
      <div>발령</div>
      <div>집결 일시</div>
      <div class="text-right">조치</div>
    </div>

    {
      sibOperationRecords.map((op) => (
        <div
          class={rowClass(op)}
          data-sib-op-row
          data-filters={op.filterBuckets.join(' ')}
          data-category={op.category}
          data-issued-at={op.issuedAt}
          data-search={`${op.code} ${op.title} ${op.category} ${op.issuer}`.toLowerCase()}
        >
          <div class="sib-op-table-status">
            {
              op.statusTags.map((tag) => (
                <span class={tagClass(tag)}>{tag.label}</span>
              ))
            }
          </div>
          <div class:list={['sib-op-table-cat', op.muted && 'muted']}>{op.category}</div>
          <div class:list={['sib-op-table-code', op.muted && 'muted']}>{op.code}</div>
          <div class:list={['sib-op-table-title', op.muted && 'muted']}>{op.title}</div>
          <div class:list={['sib-op-table-issuer', op.muted && 'muted']}>
            {op.issuer}<br />
            <span class="sib-op-table-sub">{op.issuedDate}</span>
          </div>
          <div class:list={['sib-op-table-schedule', op.muted && 'muted', op.scheduleMono && 'mono']}>
            {op.scheduleMain}<br />
            <span class="sib-op-table-sub">{op.scheduleSub}</span>
          </div>
          <div class="sib-op-table-action">
            {
              op.action === 'read' ? (
                <span class="sib-op-btn-read">열람</span>
              ) : (
                <span class:list={['sib-op-btn-detail', op.muted && 'muted']}>상세</span>
              )
            }
          </div>
        </div>
      ))
    }

    <div class="sib-op-table-foot">
      <span data-sib-op-foot-count>
        총 {sibOperationStats.total}건 중 1 — {Math.min(SIB_OP_PAGE_SIZE, sibOperationRecords.length)} 표시
      </span>
      <div class="sib-op-pagination" data-sib-op-pagination></div>
    </div>
  </div>
</div>

<script define:vars={{ pageSize: SIB_OP_PAGE_SIZE, referenceDate: SIB_OP_REFERENCE_DATE }}>
  const listRoot = document.querySelector('[data-sib-op-list]');
  if (listRoot) {
    const rows = Array.from(listRoot.querySelectorAll('[data-sib-op-row]'));
    const filterTabs = Array.from(document.querySelectorAll('[data-sib-op-filter]'));
    const statCards = Array.from(document.querySelectorAll('[data-sib-op-stat-filter]'));
    const categorySelect = document.querySelector('[data-sib-op-category]');
    const periodSelect = document.querySelector('[data-sib-op-period]');
    const searchInput = document.querySelector('[data-sib-op-search]');
    const footCount = document.querySelector('[data-sib-op-foot-count]');
    const paginationRoot = document.querySelector('[data-sib-op-pagination]');
    const refDate = new Date(`${referenceDate}T00:00:00`);

    let activeFilter = 'all';
    let activeCategory = 'all';
    let activePeriod = '3m';
    let searchQuery = '';
    let currentPage = 1;

    function getPeriodCutoff(period) {
      if (period === 'all') return null;
      const cutoff = new Date(refDate);
      cutoff.setMonth(cutoff.getMonth() - (period === '6m' ? 6 : 3));
      return cutoff;
    }

    function rowMatchesFilters(row) {
      const filters = (row.getAttribute('data-filters') || '').split(' ').filter(Boolean);
      const category = row.getAttribute('data-category') || '';
      const searchText = row.getAttribute('data-search') || '';
      const issuedAt = row.getAttribute('data-issued-at') || '';
      const query = searchQuery.trim().toLowerCase();
      const cutoff = getPeriodCutoff(activePeriod);

      const matchesFilter = activeFilter === 'all' || filters.includes(activeFilter);
      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      const matchesSearch = !query || searchText.includes(query);
      const matchesPeriod = !cutoff || (issuedAt && new Date(`${issuedAt}T00:00:00`) >= cutoff);

      return matchesFilter && matchesCategory && matchesSearch && matchesPeriod;
    }

    function getMatchingRows() {
      return rows.filter((row) => rowMatchesFilters(row));
    }

    function setActiveTab(filter) {
      activeFilter = filter;
      filterTabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-sib-op-filter') === filter;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    function renderPagination(totalPages) {
      if (!paginationRoot) return;

      if (totalPages <= 1) {
        paginationRoot.innerHTML = '';
        paginationRoot.classList.add('is-hidden');
        return;
      }

      paginationRoot.classList.remove('is-hidden');
      paginationRoot.innerHTML = '';

      const prev = document.createElement('button');
      prev.type = 'button';
      prev.className = `sib-op-page-btn${currentPage === 1 ? ' disabled' : ''}`;
      prev.textContent = '‹';
      prev.disabled = currentPage === 1;
      prev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage -= 1;
          applyFilters(false);
        }
      });
      paginationRoot.appendChild(prev);

      for (let page = 1; page <= totalPages; page += 1) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `sib-op-page-btn${page === currentPage ? ' active' : ''}`;
        btn.textContent = String(page);
        btn.addEventListener('click', () => {
          currentPage = page;
          applyFilters(false);
        });
        paginationRoot.appendChild(btn);
      }

      const next = document.createElement('button');
      next.type = 'button';
      next.className = `sib-op-page-btn${currentPage === totalPages ? ' disabled' : ''}`;
      next.textContent = '›';
      next.disabled = currentPage === totalPages;
      next.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage += 1;
          applyFilters(false);
        }
      });
      paginationRoot.appendChild(next);
    }

    function applyFilters(resetPage = true) {
      if (resetPage) currentPage = 1;

      const matching = getMatchingRows();
      const total = matching.length;
      const totalPages = Math.max(1, Math.ceil(total / pageSize));

      if (currentPage > totalPages) currentPage = totalPages;

      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = Math.min(startIdx + pageSize, total);
      const visibleOnPage = matching.slice(startIdx, endIdx);
      const visibleSet = new Set(visibleOnPage);

      rows.forEach((row) => {
        row.classList.toggle('is-filtered-out', !visibleSet.has(row));
      });

      if (footCount) {
        if (total === 0) {
          footCount.textContent = '검색 결과 없음';
        } else {
          footCount.textContent = `총 ${total}건 중 ${startIdx + 1} — ${endIdx} 표시`;
        }
      }

      renderPagination(totalPages);
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setActiveTab(tab.getAttribute('data-sib-op-filter') || 'all');
        applyFilters();
      });
    });

    statCards.forEach((card) => {
      card.addEventListener('click', () => {
        setActiveTab(card.getAttribute('data-sib-op-stat-filter') || 'all');
        applyFilters();
      });
    });

    categorySelect?.addEventListener('change', () => {
      activeCategory = categorySelect.value;
      applyFilters();
    });

    periodSelect?.addEventListener('change', () => {
      activePeriod = periodSelect.value;
      applyFilters();
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value;
      applyFilters();
    });

    applyFilters();
  }
</script>
