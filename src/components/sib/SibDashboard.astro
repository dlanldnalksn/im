---
import { url } from '../../lib/url';
import {
  sibDashboardOperations,
  sibOperationRecords,
  sibOperationStats,
} from '../../data/sib-operations-list';
import { sibDashboardReports } from '../../data/sib-reports-list';
import { sibDashboardNotices, sibNoticeBanner } from '../../data/sib-notices-list';
import SibOpCode from './SibOpCode.astro';

const base = `intranet/sib/`;
const updated = '2026.05.24 14:22';
const unreadOpIds = sibOperationRecords
  .filter((op) => op.filterBuckets.includes('unread'))
  .map((op) => op.id);

function opTagClass(variant: string) {
  if (variant === 'red') return 'red';
  if (variant === 'amber') return 'amber';
  return 'gray';
}

function noticeTagClass(filterKey: string) {
  if (filterKey === 'urgent') return 'red';
  return 'gray';
}
---

<div class="sib-page-head">
  <h1 class="sib-page-title">차출요원 통합 현황</h1>
  <div class="flex flex-wrap gap-3.5 items-center sib-page-meta">
    <span>최근 갱신 {updated}</span>
    <span class="flex items-center gap-1.5 text-[#22a06b] font-semibold">
      <span class="w-1.5 h-1.5 bg-[#22a06b] rounded-full"></span>
      접속 중
    </span>
  </div>
</div>

<div class="sib-alert">
  <div class="flex flex-wrap items-center gap-3.5">
    <span class="sib-tag red">긴급 · D-3</span>
    <span class="text-[13px] font-medium text-[#1a1a1a]">신천 사건 15주기 추모일 (05.27) — 차출요원 전원 비상 대기, 출입 제한 강화 조치</span>
  </div>
  <a href={url(`${base}notices/ntc-008/`)} class="text-[11.5px] text-imc-danger font-bold no-underline hover:underline">자세히 →</a>
</div>

<div class="sib-stat-grid">
  <div class="sib-stat-card">
    <p class="sib-stat-label">위험도 등급</p>
    <div class="sib-stat-head">
      <p class="sib-stat-value">二級</p>
      <span class="sib-stat-desc">통제 대상</span>
    </div>
    <div class="sib-stat-meta">
      <div class="sib-stat-meta-row"><span>감시 수준</span><span>상시 추적</span></div>
      <div class="sib-stat-meta-row"><span>이동 제한</span><span>관외 허가제</span></div>
    </div>
  </div>

  <div class="sib-stat-card">
    <p class="sib-stat-label">능력 등급</p>
    <div class="sib-stat-head">
      <p class="sib-stat-value">甲</p>
      <span class="sib-stat-desc">갑급 · 최고위 배치</span>
    </div>
    <div class="sib-stat-meta">
      <div class="sib-stat-meta-row"><span>방출량</span><span>최상</span></div>
      <div class="sib-stat-meta-row"><span>매칭 우선순위</span><span>최우선</span></div>
    </div>
  </div>

  <div class="sib-stat-card">
    <p class="sib-stat-label">봉인 상태</p>
    <div class="sib-stat-head">
      <p class="sib-stat-value">未實施</p>
      <span class="sib-stat-desc">차단제 처방</span>
    </div>
    <div class="sib-stat-meta">
      <div class="sib-stat-meta-row"><span>처방 약물</span><span>차단제 정기</span></div>
      <div class="sib-stat-meta-row"><span>최종 갱신</span><span>2026.05.18</span></div>
    </div>
  </div>

  <div class="sib-stat-card">
    <p class="sib-stat-label">매칭·동기화</p>
    <div class="sib-stat-head">
      <p class="sib-stat-value">未매칭</p>
      <span class="text-xs text-imc-danger font-bold" style="letter-spacing:-0.01em;">매칭 대기 중</span>
    </div>
    <div class="sib-match-steps">
      <div class="sib-match-step">
        <div class="sib-match-dot bg-imc-danger text-white">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none"><path d="M5 12l5 5L20 7" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </div>
        <span class="text-[8.5px] font-semibold text-[#525252]">접수</span>
      </div>
      <div class="sib-match-line bg-imc-danger"></div>
      <div class="sib-match-step">
        <div class="sib-match-dot bg-imc-danger text-white border border-imc-danger">2</div>
        <span class="text-[8.5px] font-bold text-imc-danger">탐색</span>
      </div>
      <div class="sib-match-line bg-[#e5e7eb]"></div>
      <div class="sib-match-step">
        <div class="sib-match-dot bg-[#f5f6f8] text-[#888] border border-[#e5e7eb]">3</div>
        <span class="text-[8.5px] font-semibold text-[#888]">평가</span>
      </div>
      <div class="sib-match-line bg-[#e5e7eb]"></div>
      <div class="sib-match-step">
        <div class="sib-match-dot bg-[#f5f6f8] text-[#888] border border-[#e5e7eb]">4</div>
        <span class="text-[8.5px] font-semibold text-[#888]">확정</span>
      </div>
    </div>
  </div>
</div>

<div class="sib-two-col">
  <div class="sib-panel">
    <div class="sib-panel-head">
      <span class="sib-panel-head-title">작전 명령서</span>
      <div class="flex gap-3.5 items-center text-[11.5px]">
        <a
          href={url(`${base}documents/?filter=unread`)}
          class="text-imc-danger font-bold no-underline hover:underline"
          data-sib-unread-link
        >
          미열람 {sibOperationStats.unread}건
        </a>
        <a href={url(`${base}documents/`)} class="text-[#525252] font-semibold no-underline hover:underline">전체보기 →</a>
      </div>
    </div>
    {
      sibDashboardOperations.map((op, i) => {
        const primaryTag = op.statusTags.find((t) => t.variant !== 'unread') ?? op.statusTags[0];
        return (
          <a
            href={url(`${base}documents/${op.id}/`)}
            class:list={[
              'sib-op-row',
              op.rowStyle === 'priority' && 'priority',
              op.rowStyle === 'urgent' && 'urgent',
              i === sibDashboardOperations.length - 1 && 'border-b-0',
            ]}
            data-sib-op-id={op.id}
            data-sib-op-unread={op.filterBuckets.includes('unread') ? 'true' : 'false'}
          >
            <div
              class:list={[
                'sib-op-bar',
                op.rowStyle === 'priority' && 'bg-imc-danger',
                op.rowStyle === 'urgent' && 'bg-[#e8b870]',
                op.muted && 'bg-[#e0e2e7]',
              ]}
            ></div>
            <div class="flex-1 min-w-0">
              <div class="sib-op-tags">
                {primaryTag && <span class:list={['sib-tag', opTagClass(primaryTag.variant)]}>{primaryTag.label}</span>}
                <SibOpCode code={op.code} muted={op.muted} />
                <span class:list={['text-[11px]', op.muted ? 'text-[#888]' : 'text-[#666]']}>{op.category}</span>
              </div>
              <p class:list={['sib-op-title', op.muted && 'font-semibold text-[#525252]']}>{op.title}</p>
              <p class:list={['sib-op-meta', op.muted && 'text-[#888]']}>
                {op.scheduleMain} · {op.scheduleSub} · {op.issuer}
              </p>
            </div>
            <span class:list={['shrink-0 text-[11.5px] font-semibold', op.muted ? 'text-[#aaa]' : 'text-[#525252]']}>
              자세히 →
            </span>
          </a>
        );
      })
    }
  </div>

  <div class="sib-panel">
    <div class="sib-panel-head">
      <a href={url(`${base}reports/`)} class="sib-panel-head-title no-underline text-inherit hover:text-imc-danger" data-sib-link="reports">
        의무 보고·일정
      </a>
      <div class="flex gap-3.5 items-center text-[11.5px]">
        <span class="text-[#92400e] font-bold">기한 임박 1건</span>
        <a href={url(`${base}reports/`)} class="text-[#525252] font-semibold no-underline hover:underline" data-sib-link="reports">전체보기 →</a>
      </div>
    </div>
    {
      sibDashboardReports.map((rpt, i) => (
        <a
          href={url(`${base}reports/${rpt.id}/`)}
          class:list={[
            'sib-report-row hover:bg-[#fafafa]',
            rpt.rowStyle === 'urgent' && 'bg-[#fffbf3] hover:bg-[#fff8eb]',
            i === sibDashboardReports.length - 1 && 'border-b-0',
          ]}
          data-sib-link="reports"
        >
          <div class="flex items-center gap-2" style="margin-bottom:6px;">
            {
              rpt.statusTags.map((tag) => (
                <span class:list={['sib-tag', tag.variant === 'urgent' ? 'amber' : 'gray']}>{tag.label}</span>
              ))
            }
            <span class:list={['text-[11px]', rpt.statusSubVariant === 'urgent' ? 'text-[#92400e] font-bold' : 'font-semibold text-[#525252]']}>
              {rpt.statusSub}
            </span>
          </div>
          <p class:list={['text-[13px]', rpt.rowStyle === 'urgent' ? 'font-bold text-[#1a1a1a]' : 'font-semibold text-[#525252]']} style="margin-bottom:4px;line-height:1.4;">
            {rpt.title}
          </p>
          <p class="sib-op-meta">
            기한 {rpt.deadlineMain} · {rpt.deadlineSub} · 양식 <span class="sib-mono-inline">{rpt.formCode}</span>
          </p>
        </a>
      ))
    }
  </div>
</div>

<div class="sib-panel" id="notices">
  <div class="sib-panel-head">
    <span class="sib-panel-head-title">내부 공지</span>
    <a href={url(`${base}notices/`)} class="text-[11.5px] text-[#525252] font-semibold no-underline hover:underline">전체보기 →</a>
  </div>
  {
    sibDashboardNotices.map((ntc, i) => (
      <a
        href={url(`${base}notices/${ntc.id}/`)}
        class:list={['sib-notice-row', i === sibDashboardNotices.length - 1 && 'border-b-0']}
      >
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <span class:list={['sib-tag shrink-0', noticeTagClass(ntc.filterKey)]}>{ntc.category}</span>
          <span class="text-[12.5px] font-semibold text-[#1a1a1a] truncate">{ntc.title}</span>
        </div>
        <span class="text-[11px] text-[#888] shrink-0 font-semibold">{ntc.postedDate}</span>
      </a>
    ))
  }
</div>

<script define:vars={{ unreadOpIds }}>
  try {
    const read = new Set(JSON.parse(localStorage.getItem('sib-read-ops') || '[]'));
    document.querySelectorAll('[data-sib-op-unread="true"]').forEach((row) => {
      const id = row.getAttribute('data-sib-op-id');
      if (id && read.has(id)) row.removeAttribute('data-sib-op-unread');
    });

    const unreadLink = document.querySelector('[data-sib-unread-link]');
    const count = unreadOpIds.filter((id) => !read.has(id)).length;

    if (unreadLink) {
      unreadLink.textContent = `미열람 ${count}건`;
      if (count === 0) {
        unreadLink.classList.remove('text-imc-danger');
        unreadLink.classList.add('text-[#888]');
      }
    }
  } catch {
    /* ignore */
  }
</script>
