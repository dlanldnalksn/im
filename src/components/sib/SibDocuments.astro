---
import { url } from '../../lib/url';
import { getDocumentsForPortal } from '../../lib/intranet-content';

const documents = getDocumentsForPortal('sib');
---

<h1 class="sib-page-title mb-2">작전·행정 자료</h1>
<p class="sib-page-meta mb-6">특수감찰국 · 대외비 · 차출요원 열람 구역</p>

<div class="grid lg:grid-cols-2 gap-3.5 mb-[18px]">
  <section class="sib-panel">
    <div class="sib-panel-head">
      <span class="sib-panel-head-title">작전 명령서</span>
      <span class="text-[11.5px] text-imc-danger font-bold">미열람 2건</span>
    </div>
    <div class="px-[22px] py-[14px] border-b border-[#f0f0f2] bg-[#fff8f5]">
      <div class="sib-op-tags">
        <span class="sib-tag red">최우선</span>
        <span class="sib-tag outline sib-op-code">OP-2026-0XXX</span>
      </div>
      <p class="sib-op-title">[극비] 수도권 □□구역 미등재자 거점 진압 작전 — 차출 명령</p>
      <p class="sib-op-meta">집결 · 05.25 04:00 / 본청 B3 · 발령 작전과장 □□□</p>
    </div>
    <div class="px-[22px] py-[14px] border-b border-[#f0f0f2] bg-[#fffbf3]">
      <div class="sib-op-tags">
        <span class="sib-tag amber">긴급</span>
        <span class="sib-tag outline sib-op-code">OP-2026-0XXX</span>
      </div>
      <p class="sib-op-title">[대외비] △△지역 신흥종교 잔당 추적 — 합동 작전</p>
      <p class="sib-op-meta">집결 · 05.28 09:00 / 지역분실 □ · 발령 □□處</p>
    </div>
    <div class="px-[22px] py-[14px] border-b border-[#f0f0f2]">
      <div class="sib-op-tags">
        <span class="sib-tag gray">완료</span>
        <span class="sib-tag outline sib-op-code text-[#888]">OP-2026-0XXX</span>
      </div>
      <p class="sib-op-title font-semibold text-[#525252]">[대외비] 보호처분소 외곽 경계 임시 차출</p>
      <p class="sib-op-meta text-[#888]">완료 · 05.20 · 보고서 제출 완료</p>
    </div>
    <div class="px-[22px] py-[14px]">
      <div class="sib-op-tags">
        <span class="sib-tag gray">완료</span>
        <span class="sib-tag outline sib-op-code text-[#888]">OP-2026-0XXX</span>
      </div>
      <p class="sib-op-title font-semibold text-[#525252]">[대외비] 미등재자 색출 합동작전 — 후속 진술 의무</p>
      <p class="sib-op-meta text-[#888]">완료 · 05.14 · 보고서 검토 중</p>
    </div>
  </section>

  <section class="sib-panel">
    <div class="sib-panel-head">
      <span class="sib-panel-head-title">의무 보고</span>
      <span class="sib-nav-badge amber">1</span>
    </div>
    <div class="sib-report-row bg-[#fffbf3]">
      <p class="text-[13px] font-bold text-[#1a1a1a] mb-1 leading-[1.4]">월간 정기 진술서 (5월분)</p>
      <p class="sib-op-meta text-[#92400e] font-bold">기한 D-1 · 양식 <span class="sib-op-code">M-FORM-03</span></p>
    </div>
    <div class="sib-report-row">
      <p class="text-[13px] font-semibold text-[#525252] mb-1 leading-[1.4]">분기 정기 검진 (2분기)</p>
      <p class="sib-op-meta text-[#888]">조정원 본원 · D-7</p>
    </div>
    <div class="sib-report-row">
      <p class="text-[13px] font-semibold text-[#525252] mb-1 leading-[1.4]">차단제 처방 갱신</p>
      <p class="sib-op-meta text-[#888]">조정원 의료센터 · D-12</p>
    </div>
  </section>
</div>

<section class="sib-panel">
  <div class="sib-panel-head">
    <span class="sib-panel-head-title">내부 자료실</span>
    <span class="text-[11.5px] text-[#666] font-medium">결재·규정·법령</span>
  </div>
  {
    documents.length === 0 ? (
      <p class="px-[22px] py-[14px] text-sm text-imc-muted">등록된 열람 자료가 없습니다.</p>
    ) : (
      <ul>
        {
          documents.map((doc) => (
            <li class:list={['flex px-[22px] py-[13px] border-b border-[#f0f0f2] justify-between items-center gap-4 last:border-0', !doc.accessible && 'opacity-75']}>
              <div>
                <p class="text-[13px] font-semibold">{doc.title}</p>
                <p class="text-[11px] text-imc-muted mt-0.5">{doc.meta}</p>
              </div>
              {
                doc.accessible ? (
                  <span class="sib-tag gray shrink-0">열람 가능</span>
                ) : (
                  <span class="sib-tag gray shrink-0 text-[#888]">권한 없음</span>
                )
              }
            </li>
          ))
        }
      </ul>
    )
  }
</section>

<p class="text-[11px] text-[#888] mt-4 font-medium">
  차출·집행 SOP·수용처 현황 등은 본 자료실에서만 열람됩니다. 무단 반출 시 형사처벌 대상.
</p>
