---
import { url } from '../../lib/url';
import { getDocumentsForPortal } from '../../lib/intranet-content';
import { sibOperations } from '../../data/sib-dashboard';
import SibOpCode from './SibOpCode.astro';

const documents = getDocumentsForPortal('sib');
---

<h1 class="sib-page-title" style="margin-bottom:8px;">작전·행정 자료</h1>
<p class="sib-page-meta" style="margin-bottom:18px;">특수감찰국 · 대외비 · 차출요원 열람 구역</p>

<div class="sib-two-col">
  <section class="sib-panel">
    <div class="sib-panel-head">
      <span class="sib-panel-head-title">작전 명령서</span>
      <span class="text-[11.5px] text-imc-danger font-bold">미열람 2건</span>
    </div>
    {
      sibOperations.map((op, i) => (
        <div
          class:list={[
            'px-[22px] border-b border-[#f0f0f2]',
            op.priority === 'priority' && 'bg-[#fff8f5]',
            op.priority === 'urgent' && 'bg-[#fffbf3]',
            i === sibOperations.length - 1 && 'border-b-0',
          ]}
          style="padding-top:14px;padding-bottom:14px;"
        >
          <div class="sib-op-tags">
            <span class:list={['sib-tag', op.tagClass]}>{op.tag}</span>
            <SibOpCode code={op.code} muted={op.muted} />
          </div>
          <p class:list={['sib-op-title', op.muted && 'font-semibold text-[#525252]']}>{op.title}</p>
          <p class:list={['sib-op-meta', op.muted && 'text-[#888]']}>{op.meta}</p>
        </div>
      ))
    }
  </section>

  <section class="sib-panel">
    <div class="sib-panel-head">
      <span class="sib-panel-head-title">의무 보고</span>
      <span class="sib-nav-badge amber">1</span>
    </div>
    <div class="sib-report-row bg-[#fffbf3]">
      <p class="text-[13px] font-bold text-[#1a1a1a]" style="margin-bottom:4px;line-height:1.4;">월간 정기 진술서 (5월분)</p>
      <p class="sib-op-meta text-[#92400e] font-bold">기한 D-1 · 양식 <span class="sib-mono-inline">M-FORM-03</span></p>
    </div>
    <div class="sib-report-row">
      <p class="text-[13px] font-semibold text-[#525252]" style="margin-bottom:4px;line-height:1.4;">분기 정기 검진 (2분기)</p>
      <p class="sib-op-meta text-[#888]">조정원 본원 · D-7</p>
    </div>
    <div class="sib-report-row">
      <p class="text-[13px] font-semibold text-[#525252]" style="margin-bottom:4px;line-height:1.4;">차단제 처방 갱신</p>
      <p class="sib-op-meta text-[#888]">조정원 의료센터 · D-12</p>
    </div>
  </section>
</div>

<section class="sib-panel">
  <div class="sib-panel-head">
    <span class="sib-panel-head-title">내부 자료실</span>
    <span class="text-[11.5px] text-[#666] font-medium">결재·규정·법령</span>
  </div>
  {
    documents.length === 0 ? (
      <p class="px-[22px] text-sm text-imc-muted" style="padding-top:14px;padding-bottom:14px;">등록된 열람 자료가 없습니다.</p>
    ) : (
      <ul>
        {
          documents.map((doc) => (
            <li class:list={['flex px-[22px] border-b border-[#f0f0f2] justify-between items-center gap-4 last:border-0', !doc.accessible && 'opacity-75']} style="padding-top:13px;padding-bottom:13px;">
              <div>
                <p class="text-[13px] font-semibold">{doc.title}</p>
                <p class="text-[11px] text-imc-muted" style="margin-top:2px;">{doc.meta}</p>
              </div>
              {
                doc.accessible ? (
                  <span class="sib-tag gray shrink-0">열람 가능</span>
                ) : (
                  <span class="sib-tag gray shrink-0 text-[#888]">권한 없음</span>
                )
              }
            </li>
          ))
        }
      </ul>
    )
  }
</section>

<p class="text-[11px] text-[#888] font-medium" style="margin-top:14px;">
  차출·집행 SOP·수용처 현황 등은 본 자료실에서만 열람됩니다. 무단 반출 시 형사처벌 대상.
</p>
