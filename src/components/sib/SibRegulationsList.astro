---
import { url } from '../../lib/url';
import {
  SIB_REG_PAGE_SIZE,
  SIB_REG_TOTAL_DOCUMENTS,
  sibRegulationAmendment,
  sibRegulationCategories,
  sibRegulationRecords,
} from '../../data/sib-regulations-list';
import type { SibRegulationRecord } from '../../data/sib-regulations-list';

const base = 'intranet/sib/';

const quickNav = [
  { label: '작전 명령', href: `${base}documents/` },
  { label: '의무 보고', href: `${base}reports/` },
  { label: '결재·신청', href: `${base}approvals/` },
  { label: '공지·알림', href: `${base}notices/` },
  { label: '신상·인사', href: `${base}personnel/lee-chan-young/` },
];

const sortOptions = [
  { label: '최근 개정순', value: 'recent' },
  { label: '시행일순', value: 'effective' },
  { label: '법령 번호순', value: 'code' },
];

function rowClass(rec: SibRegulationRecord) {
  if (rec.rowStyle === 'revised') return 'sib-reg-table-row revised';
  return 'sib-reg-table-row';
}

function statusTagClass(rec: SibRegulationRecord) {
  if (rec.statusVariant === 'revised') return 'sib-reg-tag revised';
  return 'sib-reg-tag active';
}
---

<nav class="sib-breadcrumb" aria-label="경로">
  <a href={url(`${base}`)} class="sib-breadcrumb-link">대시보드</a>
  <span class="sib-breadcrumb-sep">›</span>
  <span class="sib-breadcrumb-current">규정·법령</span>
</nav>

<div class="sib-page-head">
  <div>
    <h1 class="sib-page-title">규정·법령</h1>
    <p class="sib-page-subtitle">이능관리법 · 시행령 · 특수감찰국 내규 · 차출요원 복무 규정 외</p>
  </div>
  <div class="sib-reg-head-actions">
    <button type="button" class="sib-reg-btn-outline" data-sib-reg-inquiry-open>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 17v.01M12 14a2 2 0 002-2c0-1.5-2-2-2-4a2 2 0 014 0M12 22a10 10 0 110-20 10 10 0 010 20z" stroke="#525252" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      규정 문의
    </button>
    <button type="button" class="sib-reg-fav-btn" data-sib-reg-fav-btn aria-pressed="false">
      즐겨찾기 ★ <span data-sib-reg-fav-count>0</span>
    </button>
  </div>
</div>

<div class="sib-reg-inquiry-modal is-hidden" data-sib-reg-inquiry-modal role="dialog" aria-modal="true" aria-labelledby="sib-reg-inquiry-title">
  <div class="sib-reg-inquiry-backdrop" data-sib-reg-inquiry-close></div>
  <div class="sib-reg-inquiry-panel">
    <div class="sib-reg-inquiry-head">
      <h2 id="sib-reg-inquiry-title">규정·법령 문의</h2>
      <button type="button" class="sib-reg-inquiry-close" data-sib-reg-inquiry-close aria-label="닫기">×</button>
    </div>
    <p class="sib-reg-inquiry-lead">법령 해석·적용·개정 관련 문의는 아래 담당으로 접수합니다.</p>
    <dl class="sib-reg-inquiry-dl">
      <div><dt>담당</dt><dd>특수감찰국 행정과 · 규정담당</dd></div>
      <div><dt>내선</dt><dd>2281 · 2282</dd></div>
      <div><dt>접수</dt><dd>내부망 규정문의 게시판 · 전자결재(행정-규정)</dd></div>
      <div><dt>처리</dt><dd>영업일 기준 3일 이내 회신 (긴급 시 당일)</dd></div>
    </dl>
    <button type="button" class="sib-reg-inquiry-confirm" data-sib-reg-inquiry-close>확인</button>
  </div>
</div>

<a href={url(`${base}regulations/reg-024/`)} class="sib-reg-amendment no-underline text-inherit">
  <div class="sib-reg-amendment-body">
    <span class="sib-reg-amendment-label">최근 개정</span>
    <p class="sib-reg-amendment-text">
      <span class="sib-reg-amendment-code">{sibRegulationAmendment.code}</span>
      {sibRegulationAmendment.title} — <strong>{sibRegulationAmendment.highlight}</strong> ({sibRegulationAmendment.effectiveDate} 시행)
    </p>
  </div>
  <span class="sib-reg-amendment-link">개정안 →</span>
</a>

<div class="sib-reg-category-grid">
  {
    sibRegulationCategories.map((cat) => (
      <button
        type="button"
        class:list={['sib-reg-category-card', cat.accent && 'accent']}
        data-sib-reg-category-filter={cat.filterKey}
      >
        <div class="sib-reg-category-top">
          <div class="sib-reg-category-title">{cat.title}</div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <p class="sib-reg-category-desc">{cat.description}</p>
        <div class="sib-reg-category-foot">
          <span>{cat.count}개 문서</span>
          <span class="sib-reg-category-code">{cat.code}</span>
        </div>
      </button>
    ))
  }
</div>

<div class="sib-op-toolbar" data-sib-reg-toolbar>
  <nav class="sib-reg-quick-nav" aria-label="관련 메뉴 빠른 이동">
    {
      quickNav.map((item) => (
        <a href={url(item.href)} class="sib-reg-quick-nav-link">
          {item.label}
          <span aria-hidden="true">→</span>
        </a>
      ))
    }
  </nav>
  <div class="sib-op-toolbar-right">
    <label class="sib-op-select">
      <span class="sib-op-select-label">정렬</span>
      <select class="sib-op-select-native" data-sib-reg-sort aria-label="정렬">
        {
          sortOptions.map((opt) => (
            <option value={opt.value} selected={opt.value === 'recent'}>
              {opt.label}
            </option>
          ))
        }
      </select>
      <span class="sib-op-select-caret" aria-hidden="true">▾</span>
    </label>
    <label class="sib-op-search sib-reg-search">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="#888" stroke-width="2"></circle>
        <path d="M21 21l-4-4" stroke="#888" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        class="sib-op-search-input"
        data-sib-reg-search
        placeholder="법령 / 조항 / 키워드 검색"
        aria-label="법령 조항 키워드 검색"
      />
    </label>
  </div>
</div>

<div class="sib-op-table-wrap" data-sib-reg-list>
  <div class="sib-reg-table">
    <div class="sib-reg-table-head">
      <div>분류</div>
      <div>법령 번호</div>
      <div>소관 부서</div>
      <div>제목</div>
      <div>시행일</div>
      <div class="text-right">조치</div>
    </div>

    {
      sibRegulationRecords.map((rec) => (
        <div
          class={rowClass(rec)}
          data-sib-reg-row
          data-reg-id={rec.id}
          data-href={url(`${base}regulations/${rec.id}/`)}
          data-filter={rec.filterKey}
          data-reference-date={rec.referenceDate}
          data-rule-code={rec.ruleCode}
          data-search={`${rec.ruleCode} ${rec.title} ${rec.category} ${rec.department} ${rec.titleNote || ''}`.toLowerCase()}
          role="link"
          tabindex="0"
        >
          <div class="sib-reg-table-status">
            <span class={statusTagClass(rec)}>{rec.statusLabel}</span>
            <span class="sib-reg-table-cat-sub">{rec.category}</span>
          </div>
          <div class:list={['sib-reg-table-code', rec.rowStyle === 'revised' && 'active']}>{rec.ruleCode}</div>
          <div class="sib-reg-table-dept">{rec.department}</div>
          <div class:list={['sib-reg-table-title', rec.rowStyle === 'revised' && 'active']}>{rec.title}{rec.titleNote && (<><br /><span class:list={['sib-reg-title-note', rec.titleNoteVariant === 'revised' && 'revised', rec.titleNoteVariant === 'muted' && 'muted']}>{rec.titleNote}</span></>)}</div>
          <div class:list={['sib-reg-table-date', rec.effectiveDateBold && 'bold']}>{rec.effectiveDate}</div>
          <div class="sib-reg-table-action">
            <button
              type="button"
              class="sib-reg-star-btn"
              data-sib-reg-star
              data-reg-id={rec.id}
              aria-label="즐겨찾기 추가"
              aria-pressed="false"
            >
              <svg
                class="sib-reg-star"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12 17.27l5.18 3.13-1.37-5.89L20.4 9.59l-5.99-.52L12 3.5l-2.41 5.57L3.6 9.59l4.59 4.92-1.37 5.89z"
                  stroke="#888"
                  stroke-width="2"
                ></path>
              </svg>
            </button>
            <span class:list={['sib-reg-btn-link', rec.rowStyle === 'revised' && 'active']}>조회 →</span>
          </div>
        </div>
      ))
    }

    <div class="sib-op-table-foot">
      <span data-sib-reg-foot-count>
        총 {SIB_REG_TOTAL_DOCUMENTS}개 문서 중 1 — {Math.min(SIB_REG_PAGE_SIZE, sibRegulationRecords.length)} 표시
      </span>
      <div class="sib-op-pagination" data-sib-reg-pagination></div>
    </div>
  </div>
</div>

<script define:vars={{ pageSize: SIB_REG_PAGE_SIZE }}>
  const FAV_STORAGE_KEY = 'sib-reg-favorites-v3';
  const LEGACY_FAV_KEYS = ['sib-reg-favorites', 'sib-reg-favorites-v2'];

  function loadFavorites() {
    try {
      const raw = localStorage.getItem(FAV_STORAGE_KEY);
      if (raw) return new Set(JSON.parse(raw));
    } catch {
      /* ignore */
    }
    LEGACY_FAV_KEYS.forEach((key) => localStorage.removeItem(key));
    return new Set();
  }

  function saveFavorites(favorites) {
    localStorage.setItem(FAV_STORAGE_KEY, JSON.stringify([...favorites]));
  }

  function syncStarButton(btn, isFavorite) {
    const svg = btn.querySelector('.sib-reg-star');
    const path = btn.querySelector('path');
    btn.setAttribute('aria-pressed', isFavorite ? 'true' : 'false');
    btn.setAttribute('aria-label', isFavorite ? '즐겨찾기 해제' : '즐겨찾기 추가');
    svg?.classList.toggle('filled', isFavorite);
    if (svg) svg.setAttribute('fill', isFavorite ? 'currentColor' : 'none');
    if (path) {
      path.setAttribute('stroke', isFavorite ? 'none' : '#888');
      path.setAttribute('stroke-width', isFavorite ? '0' : '2');
    }
  }

  function updateFavoriteCount(favorites) {
    const countEl = document.querySelector('[data-sib-reg-fav-count]');
    if (countEl) countEl.textContent = String(favorites.size);
  }

  let favorites = loadFavorites();
  let showFavoritesOnly = false;
  let applyFiltersRef = null;

  const favBtn = document.querySelector('[data-sib-reg-fav-btn]');
  favBtn?.addEventListener('click', () => {
    showFavoritesOnly = !showFavoritesOnly;
    favBtn.classList.toggle('is-active', showFavoritesOnly);
    favBtn.setAttribute('aria-pressed', showFavoritesOnly ? 'true' : 'false');
    applyFiltersRef?.();
  });

  const inquiryModal = document.querySelector('[data-sib-reg-inquiry-modal]');
  const openInquiry = () => inquiryModal?.classList.remove('is-hidden');
  const closeInquiry = () => inquiryModal?.classList.add('is-hidden');

  document.querySelector('[data-sib-reg-inquiry-open]')?.addEventListener('click', openInquiry);
  document.querySelectorAll('[data-sib-reg-inquiry-close]').forEach((el) => {
    el.addEventListener('click', closeInquiry);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !inquiryModal?.classList.contains('is-hidden')) closeInquiry();
  });

  document.querySelectorAll('[data-sib-reg-star]').forEach((btn) => {
    const id = btn.getAttribute('data-reg-id');
    if (!id) return;
    syncStarButton(btn, favorites.has(id));
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (favorites.has(id)) favorites.delete(id);
      else favorites.add(id);
      saveFavorites(favorites);
      syncStarButton(btn, favorites.has(id));
      updateFavoriteCount(favorites);
      if (showFavoritesOnly) applyFiltersRef?.();
    });
  });

  updateFavoriteCount(favorites);

  document.querySelectorAll('[data-sib-reg-row][data-href]').forEach((row) => {
    const navigate = () => {
      const href = row.getAttribute('data-href');
      if (href) window.location.href = href;
    };
    row.addEventListener('click', (event) => {
      if (event.target.closest('[data-sib-reg-star]')) return;
      navigate();
    });
    row.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      if (event.target.closest('[data-sib-reg-star]')) return;
      event.preventDefault();
      navigate();
    });
  });

  const listRoot = document.querySelector('[data-sib-reg-list]');
  if (listRoot) {
    const rows = Array.from(listRoot.querySelectorAll('[data-sib-reg-row]'));
    const categoryCards = Array.from(document.querySelectorAll('[data-sib-reg-category-filter]'));
    const sortSelect = document.querySelector('[data-sib-reg-sort]');
    const searchInput = document.querySelector('[data-sib-reg-search]');
    const footCount = document.querySelector('[data-sib-reg-foot-count]');
    const paginationRoot = document.querySelector('[data-sib-reg-pagination]');

    let activeFilter = 'all';
    let activeSort = 'recent';
    let searchQuery = '';
    let currentPage = 1;

    function rowMatchesFilters(row) {
      const filter = row.getAttribute('data-filter') || '';
      const regId = row.getAttribute('data-reg-id') || '';
      const searchText = row.getAttribute('data-search') || '';
      const query = searchQuery.trim().toLowerCase();
      const matchesFilter = activeFilter === 'all' || filter === activeFilter;
      const matchesSearch = !query || searchText.includes(query);
      const matchesFavorites = !showFavoritesOnly || favorites.has(regId);
      return matchesFilter && matchesSearch && matchesFavorites;
    }

    function sortRows(matching) {
      const sorted = [...matching];
      sorted.sort((a, b) => {
        if (activeSort === 'code') {
          return (a.getAttribute('data-rule-code') || '').localeCompare(b.getAttribute('data-rule-code') || '');
        }
        if (activeSort === 'effective') {
          return (b.getAttribute('data-reference-date') || '').localeCompare(a.getAttribute('data-reference-date') || '');
        }
        return (b.getAttribute('data-reference-date') || '').localeCompare(a.getAttribute('data-reference-date') || '');
      });
      return sorted;
    }

    function getMatchingRows() {
      return sortRows(rows.filter((row) => rowMatchesFilters(row)));
    }

    function setActiveCategory(filter) {
      activeFilter = filter;
      categoryCards.forEach((card) => {
        const key = card.getAttribute('data-sib-reg-category-filter') || '';
        card.classList.toggle('is-active', filter !== 'all' && key === filter);
      });
    }

    function renderPagination(totalPages) {
      if (!paginationRoot) return;

      if (totalPages <= 1) {
        paginationRoot.innerHTML = '';
        paginationRoot.classList.add('is-hidden');
        return;
      }

      paginationRoot.classList.remove('is-hidden');
      paginationRoot.innerHTML = '';

      const prev = document.createElement('button');
      prev.type = 'button';
      prev.className = `sib-op-page-btn${currentPage === 1 ? ' disabled' : ''}`;
      prev.textContent = '‹';
      prev.disabled = currentPage === 1;
      prev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage -= 1;
          applyFilters(false);
        }
      });
      paginationRoot.appendChild(prev);

      const maxButtons = totalPages;
      for (let page = 1; page <= maxButtons; page += 1) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `sib-op-page-btn${page === currentPage ? ' active' : ''}`;
        btn.textContent = String(page);
        btn.addEventListener('click', () => {
          currentPage = page;
          applyFilters(false);
        });
        paginationRoot.appendChild(btn);
      }

      const next = document.createElement('button');
      next.type = 'button';
      next.className = `sib-op-page-btn${currentPage === totalPages ? ' disabled' : ''}`;
      next.textContent = '›';
      next.disabled = currentPage === totalPages;
      next.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage += 1;
          applyFilters(false);
        }
      });
      paginationRoot.appendChild(next);
    }

    function applyFilters(resetPage = true) {
      if (resetPage) currentPage = 1;

      const matching = getMatchingRows();
      const filteredTotal = matching.length;
      const totalPages = Math.max(1, Math.ceil(filteredTotal / pageSize));

      if (currentPage > totalPages) currentPage = totalPages;

      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = Math.min(startIdx + pageSize, filteredTotal);
      const visibleOnPage = matching.slice(startIdx, endIdx);
      const visibleSet = new Set(visibleOnPage);

      rows.forEach((row) => {
        row.classList.toggle('is-filtered-out', !visibleSet.has(row));
      });

      if (footCount) {
        if (filteredTotal === 0) {
          footCount.textContent = '검색 결과 없음';
        } else {
          footCount.textContent = `총 ${filteredTotal}개 문서 중 ${startIdx + 1} — ${endIdx} 표시`;
        }
      }

      renderPagination(totalPages);
    }

    categoryCards.forEach((card) => {
      card.addEventListener('click', () => {
        const key = card.getAttribute('data-sib-reg-category-filter') || 'all';
        if (activeFilter === key) setActiveCategory('all');
        else setActiveCategory(key);
        applyFilters();
      });
    });

    sortSelect?.addEventListener('change', () => {
      activeSort = sortSelect.value;
      applyFilters();
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value;
      applyFilters();
    });

    applyFiltersRef = applyFilters;
    setActiveCategory('all');
    applyFilters();
  }
</script>
