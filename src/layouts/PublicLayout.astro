---
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = '이능관리위원회 공식 대외 누리집', fullWidth = false } = Astro.props;
const pageTitle = `${title} | 이능관리위원회`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&family=Nanum+Myeongjo:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <div class="site-shell">
      <PublicHeader />
      <main class:list={['flex-1', fullWidth ? '' : 'px-4 md:px-10 py-8']}>
        <slot />
      </main>
      <PublicFooter />
    </div>
  </body>
</html>
