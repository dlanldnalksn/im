---
import PublicGovBanner from '../components/PublicGovBanner.astro';
import IntranetHeader from '../components/IntranetHeader.astro';
import IntranetGuard from '../components/IntranetGuard.astro';
import type { IntranetPortal } from '../data/intranet-portals';
import '../styles/global.css';

interface Props {
  title: string;
  portal: IntranetPortal;
  requireAuth?: boolean;
}

const { title, portal, requireAuth = true } = Astro.props;
const pageTitle = `${title} | ${portal.name} 내부망`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href={import.meta.env.BASE_URL} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&family=Nanum+Myeongjo:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#eef0f3]">
    <PublicGovBanner />
    {requireAuth && <IntranetGuard portalId={portal.id} />}
    <IntranetHeader portal={portal} />
    <main class="mx-auto w-full max-w-site bg-white shadow-site min-h-[60vh] px-4 md:px-10 py-8">
      <slot />
    </main>
    <footer class="bg-[#1a1a1a] text-[#666] py-4 text-center text-xs font-mono tracking-wide">
      {portal.code} 내부망 · 접속 기록 보관 · 문서 무단 반출 시 징계
    </footer>
  </body>
</html>
