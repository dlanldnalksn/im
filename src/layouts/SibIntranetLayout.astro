---
import SibIntranetHeader from '../components/sib/SibIntranetHeader.astro';
import SibIntranetFooter from '../components/sib/SibIntranetFooter.astro';
import IntranetGuard from '../components/IntranetGuard.astro';
import '../styles/global.css';
import '../styles/sib-intranet.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = `${title} | 특수감찰국 인트라넷`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href={import.meta.env.BASE_URL} />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{pageTitle}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&family=Nanum+Myeongjo:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#f1f3f5]">
    <div class="flex justify-center">
      <div class="sib-shell">
        <IntranetGuard portalId="sib" />
        <SibIntranetHeader />
        <main class="sib-main">
          <slot />
        </main>
        <SibIntranetFooter />
      </div>
    </div>
    <script define:vars={{ sibBase: 'intranet/sib/' }}>
      const SIB_NAV_PATHS = {
        dashboard: `${sibBase}`,
        documents: `${sibBase}documents/`,
        reports: `${sibBase}reports/`,
        approvals: `${sibBase}approvals/`,
        regulations: `${sibBase}regulations/`,
        personnel: `${sibBase}personnel/lee-chan-young/`,
      };

      function sibUrl(path) {
        return new URL(path, document.baseURI).href;
      }

      function syncSibNavLinks() {
        document.querySelectorAll('[data-sib-nav]').forEach((link) => {
          const key = link.getAttribute('data-sib-nav');
          const path = SIB_NAV_PATHS[key];
          if (path) link.href = sibUrl(path);
        });

        document.querySelectorAll('[data-sib-link="reports"]').forEach((link) => {
          link.href = sibUrl(SIB_NAV_PATHS.reports);
        });

        // bfcache 등 구버전 HTML: 텍스트로 의무 보고 링크 보정
        document.querySelectorAll('.sib-nav-link').forEach((link) => {
          const label = link.textContent.replace(/\d+/g, '').trim();
          if (label.startsWith('의무 보고')) {
            link.href = sibUrl(SIB_NAV_PATHS.reports);
          }
        });
      }

      syncSibNavLinks();

      window.addEventListener('pageshow', (event) => {
        syncSibNavLinks();

        if (event.persisted) {
          window.location.reload();
          return;
        }

        const path = window.location.pathname;
        const title = document.title;
        if (path.includes('/reports') && !title.includes('의무 보고')) {
          window.location.reload();
        } else if (path.includes('/documents') && !title.includes('작전 명령')) {
          window.location.reload();
        } else if (path.includes('/approvals') && !title.includes('결재·신청')) {
          window.location.reload();
        } else if (path.includes('/regulations') && !title.includes('규정·법령')) {
          window.location.reload();
        }
      });
    </script>
  </body>
</html>
