---
import SibIntranetHeader from '../components/sib/SibIntranetHeader.astro';
import SibIntranetFooter from '../components/sib/SibIntranetFooter.astro';
import IntranetGuard from '../components/IntranetGuard.astro';
import '../styles/global.css';
import '../styles/sib-intranet.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = `${title} | 특수감찰국 인트라넷`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href={import.meta.env.BASE_URL} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&family=Nanum+Myeongjo:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#f1f3f5]">
    <div class="flex justify-center">
      <div class="sib-shell">
        <IntranetGuard portalId="sib" />
        <SibIntranetHeader />
        <main class="sib-main">
          <slot />
        </main>
        <SibIntranetFooter />
      </div>
    </div>
  </body>
</html>
